<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_incident_report_form" model="ir.ui.view">
        <field name="name">binaryaid.care.incident.report.form</field><field name="model">binaryaid.care.incident</field>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <form string="Report an incident">
                <sheet>
                    <div class="alert alert-info" role="status"><field name="external_notice" readonly="1"/></div>
                    <field name="allowed_client_ids" invisible="1"/>
                    <group>
                        <group><field name="client_id" options="{'no_create': True, 'no_open': True}"/><field name="occurred_at"/><field name="location" placeholder="Where it happened"/></group>
                        <group><field name="category_id" options="{'no_create': True, 'no_open': True}"/><field name="severity" widget="radio" options="{'horizontal': true}"/></group>
                    </group>
                    <group>
                        <field name="description" placeholder="What happened, in order. Facts only."/>
                        <field name="immediate_action" placeholder="What you did straight away to keep people safe"/>
                        <field name="attachment_ids" widget="many2many_binary" string="Photos, video or audio"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_incident_list" model="ir.ui.view">
        <field name="name">binaryaid.care.incident.list</field><field name="model">binaryaid.care.incident</field>
        <field name="arch" type="xml">
            <list create="false" decoration-danger="severity in ('high', 'critical') and state != 'closed'" decoration-muted="state == 'closed'">
                <field name="name"/><field name="occurred_at"/><field name="client_id"/><field name="category_id"/>
                <field name="severity" widget="badge"/><field name="reported_by_id"/><field name="owner_id"/><field name="state" widget="badge"/>
            </list>
        </field>
    </record>
    <record id="view_incident_form" model="ir.ui.view">
        <field name="name">binaryaid.care.incident.form</field><field name="model">binaryaid.care.incident</field>
        <field name="arch" type="xml">
            <form string="Incident" create="false" delete="false">
                <header>
                    <button name="action_review" type="object" string="Start review" class="btn-primary" invisible="state != 'submitted'" groups="binaryaid_care.group_care_reviewer"/>
                    <button name="action_require_action" type="object" string="Action required" invisible="state not in ('submitted', 'in_review')" groups="binaryaid_care.group_care_reviewer"/>
                    <button name="action_close" type="object" string="Close" invisible="state == 'closed'" groups="binaryaid_care.group_care_reviewer"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="alert alert-warning" role="status"><field name="external_notice" readonly="1"/></div>
                    <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                    <group>
                        <group><field name="client_id" readonly="1"/><field name="occurred_at" readonly="1"/><field name="location" readonly="1"/><field name="shift_id" readonly="1"/></group>
                        <group><field name="category_id"/><field name="severity"/><field name="reported_by_id"/><field name="owner_id"/></group>
                    </group>
                    <group string="Report"><field name="description" readonly="1"/><field name="immediate_action" readonly="1"/>
                        <field name="attachment_ids" widget="many2many_binary" readonly="1"/></group>
                    <group string="Review"><field name="outcome" placeholder="Investigation, follow-up and any external notifications made"/></group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="view_incident_search" model="ir.ui.view">
        <field name="name">binaryaid.care.incident.search</field><field name="model">binaryaid.care.incident</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/><field name="client_id"/><field name="reported_by_id"/>
                <filter name="open" string="Open" domain="[('state', '!=', 'closed')]"/>
                <filter name="serious" string="High or critical" domain="[('severity', 'in', ['high', 'critical'])]"/>
                <filter name="occurred" string="Occurred" date="occurred_at"/>
                <group><filter name="group_category" string="Category" context="{'group_by': 'category_id'}"/><filter name="group_client" string="Client" context="{'group_by': 'client_id'}"/></group>
            </search>
        </field>
    </record>
    <record id="action_incidents" model="ir.actions.act_window">
        <field name="name">Incident Reports</field><field name="res_model">binaryaid.care.incident</field>
        <field name="view_mode">list,form</field><field name="context">{'search_default_open': 1}</field>
        <field name="views" eval="[(ref('view_incident_list'), 'list'), (ref('view_incident_form'), 'form')]"/>
    </record>
    <record id="action_my_incidents" model="ir.actions.act_window">
        <field name="name">My Incident Reports</field><field name="res_model">binaryaid.care.incident</field>
        <field name="view_mode">list,form</field><field name="domain">[('reported_by_id', '=', uid)]</field>
        <field name="views" eval="[(ref('view_incident_list'), 'list'), (ref('view_incident_form'), 'form')]"/>
    </record>
    <record id="action_incident_categories" model="ir.actions.act_window">
        <field name="name">Incident Categories</field><field name="res_model">binaryaid.care.incident.category</field><field name="view_mode">list</field>
    </record>
    <record id="view_incident_category_list" model="ir.ui.view">
        <field name="name">binaryaid.care.incident.category.list</field><field name="model">binaryaid.care.incident.category</field>
        <field name="arch" type="xml"><list editable="bottom"><field name="sequence" widget="handle"/><field name="name"/><field name="active" widget="boolean_toggle"/></list></field>
    </record>
</odoo>
