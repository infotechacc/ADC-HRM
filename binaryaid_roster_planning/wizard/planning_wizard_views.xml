<odoo>
    <record id="view_assign_wizard" model="ir.ui.view"><field name="name">roster.assign.wizard</field><field name="model">binaryaid.roster.assign.wizard</field><field name="arch" type="xml"><form string="Assign Schedule to Employees"><div class="alert alert-info" role="status">One action creates effective-dated assignments for the whole group. Existing assignments are never silently replaced. End the current assignment first when scheduling a future change.</div><group><field name="company_id" groups="base.group_multi_company"/><field name="template_id"/><field name="policy_id"/><field name="department_id"/><field name="employee_ids" widget="many2many_tags" domain="[('company_id', '=', company_id), ('active', '=', True)] + ([('department_id', '=', department_id)] if department_id else [])"/><field name="date_start"/><field name="date_end"/><field name="phase_days"/><field name="horizon_days"/><field name="auto_publish"/></group><footer><button name="action_assign" string="Assign Group" type="object" class="btn-primary"/><button special="cancel" string="Cancel"/></footer></form></field></record>
    <record id="view_generate_wizard" model="ir.ui.view"><field name="name">roster.generate.wizard</field><field name="model">binaryaid.roster.generate.wizard</field><field name="arch" type="xml"><form string="Generate Roster Preview"><group><field name="assignment_ids" widget="many2many_tags" domain="[('state', '=', 'active')]"/><field name="date_from"/><field name="date_to"/><field name="estimated_occurrences"/></group><div class="alert alert-info" role="status">Existing occurrences are skipped, including cancelled and edited shifts. New shifts are drafts unless their assignment explicitly enables automatic publication. Review the resulting run for conflicts and DST exceptions.</div><footer><button name="action_generate" string="Generate" type="object" class="btn-primary"/><button special="cancel" string="Cancel"/></footer></form></field></record>
    <record id="view_end_wizard" model="ir.ui.view"><field name="name">roster.end.wizard</field><field name="model">binaryaid.roster.end.wizard</field><field name="arch" type="xml"><form string="End / Change Schedule"><group><field name="assignment_id"/><field name="date_end"/><field name="reason"/></group><p>Future generated shifts starting after the end date will be cancelled with this reason. Past shifts remain fixed. Create the next assignment starting the following day.</p><footer><button name="action_end" string="End Assignment" type="object" class="btn-primary"/><button special="cancel" string="Cancel"/></footer></form></field></record>
    <record id="view_publish_wizard" model="ir.ui.view"><field name="name">roster.publish.wizard</field><field name="model">binaryaid.roster.publish.wizard</field><field name="arch" type="xml"><form string="Review and Publish"><group><field name="shift_ids" widget="many2many_tags" domain="[('state', '=', 'draft')]"/><field name="review_note"/></group><p>All selected shifts must pass validation. If any fails, none of the selected shifts is published. Review evidence records a decision; it does not waive award obligations or replace employee consultation.</p><footer><button name="action_publish" string="Publish Reviewed Shifts" type="object" class="btn-primary"/><button special="cancel" string="Cancel"/></footer></form></field></record>
    <record id="action_batch_publish" model="ir.actions.act_window"><field name="name">Review and Publish</field><field name="res_model">binaryaid.roster.publish.wizard</field><field name="view_mode">form</field><field name="target">new</field></record>
    <record id="action_batch_publish_binding" model="ir.actions.server"><field name="name">Review and Publish</field><field name="model_id" ref="binaryaid_work_scheduling.model_binaryaid_work_shift"/><field name="binding_model_id" ref="binaryaid_work_scheduling.model_binaryaid_work_shift"/><field name="binding_view_types">list</field><field name="group_ids" eval="[(4, ref('binaryaid_work_management.group_work_admin'))]"/><field name="state">code</field><field name="code">action = {'type': 'ir.actions.act_window', 'name': 'Review and Publish', 'res_model': 'binaryaid.roster.publish.wizard', 'view_mode': 'form', 'target': 'new', 'context': {'default_shift_ids': [(6, 0, records.ids)]}}</field></record>
    <record id="view_cover_wizard" model="ir.ui.view"><field name="name">roster.cover.wizard</field><field name="model">binaryaid.roster.cover.wizard</field><field name="arch" type="xml"><form string="Replace or Swap Shift"><group><field name="shift_id"/><field name="company_id" invisible="1"/><field name="mode"/><field name="employee_id" invisible="mode != 'replace'" required="mode == 'replace'" domain="[('company_id', '=', company_id)]"/><field name="swap_shift_id" invisible="mode != 'swap'" required="mode == 'swap'" domain="[('state', '=', 'published'), ('company_id', '=', company_id), ('id', '!=', shift_id)]"/><field name="policy_id"/><field name="reason"/><field name="review_note"/></group><div class="alert alert-info" role="status">Original shifts remain in history as cancelled. New linked shifts and employee tasks are created. Both sides of a swap succeed together or neither changes. The receiving employee's policy is used unless a reviewed coverage policy is selected.</div><footer><button name="action_apply" string="Approve Coverage / Swap" type="object" class="btn-primary"/><button special="cancel" string="Cancel"/></footer></form></field></record>
    <record id="view_actual_wizard" model="ir.ui.view"><field name="name">roster.actual.wizard</field><field name="model">binaryaid.roster.actual.wizard</field><field name="arch" type="xml"><form string="Reconcile Actual Attendance"><group><field name="shift_id"/><field name="employee_id" readonly="1"/><field name="is_void"/><field name="attendance_ids" widget="many2many_tags" invisible="is_void" domain="[('employee_id', '=', employee_id), ('check_out', '!=', False)]"/><field name="reason"/></group><p>Native Attendance worked hours are snapshotted without another break deduction. Each closed session can belong to only one current approval. Corrections and reversals append new history; they do not change attendance or payroll.</p><footer><button name="action_approve" string="Approve / Record Correction" type="object" class="btn-primary"/><button special="cancel" string="Cancel"/></footer></form></field></record>
</odoo>
