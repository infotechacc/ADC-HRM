<odoo>
    <record id="rule_policy_company" model="ir.rule">
        <field name="name">Roster policy: allowed companies</field>
        <field name="model_id" ref="model_binaryaid_roster_policy"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_template_company" model="ir.rule">
        <field name="name">Roster template: allowed companies</field>
        <field name="model_id" ref="model_binaryaid_roster_template"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_template_line_company" model="ir.rule">
        <field name="name">Roster template.line: allowed companies</field>
        <field name="model_id" ref="model_binaryaid_roster_template_line"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_task_recipe_company" model="ir.rule">
        <field name="name">Roster task.recipe: allowed companies</field>
        <field name="model_id" ref="model_binaryaid_roster_task_recipe"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_assignment_company" model="ir.rule">
        <field name="name">Roster assignment: allowed companies</field>
        <field name="model_id" ref="model_binaryaid_roster_assignment"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_run_company" model="ir.rule">
        <field name="name">Roster run: allowed companies</field>
        <field name="model_id" ref="model_binaryaid_roster_run"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_issue_company" model="ir.rule">
        <field name="name">Roster issue: allowed companies</field>
        <field name="model_id" ref="model_binaryaid_roster_issue"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_event_company" model="ir.rule">
        <field name="name">Roster event: allowed companies</field>
        <field name="model_id" ref="model_binaryaid_roster_event"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_actual_company" model="ir.rule">
        <field name="name">Roster actual: allowed companies</field>
        <field name="model_id" ref="model_binaryaid_roster_actual"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_event_owner" model="ir.rule">
        <field name="name">Roster event: historical owner or administrator</field>
        <field name="model_id" ref="model_binaryaid_roster_event"/>
        <field name="domain_force">[(1, '=', 1)] if user.has_group('binaryaid_work_management.group_work_admin') else [('user_id', '=', user.id), ('shift_id.user_id', '=', user.id), ('shift_id.state', 'in', ['published', 'cancelled'])]</field>
    </record>
    <record id="rule_actual_owner" model="ir.rule">
        <field name="name">Roster actual: historical owner or administrator</field>
        <field name="model_id" ref="model_binaryaid_roster_actual"/>
        <field name="domain_force">[(1, '=', 1)] if user.has_group('binaryaid_work_management.group_work_admin') else [('user_id', '=', user.id), ('shift_id.user_id', '=', user.id), ('shift_id.state', 'in', ['published', 'cancelled'])]</field>
    </record>
</odoo>
