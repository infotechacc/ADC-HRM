<odoo>
    <record id="view_policy_list" model="ir.ui.view"><field name="name">roster.policy.list</field><field name="model">binaryaid.roster.policy</field><field name="arch" type="xml"><list><field name="name"/><field name="reference"/><field name="employment_type"/><field name="weekly_hours_limit"/><field name="state" widget="badge"/><field name="company_id" groups="base.group_multi_company"/></list></field></record>
    <record id="view_policy_form" model="ir.ui.view"><field name="name">roster.policy.form</field><field name="model">binaryaid.roster.policy</field><field name="arch" type="xml"><form><header><button name="action_approve" string="Approve Policy" type="object" class="btn-primary" invisible="state != 'draft'"/><field name="state" widget="statusbar"/></header><sheet>
        <div class="alert alert-info" role="status">These are roster review controls, not an award interpretation or payroll engine. Configure for the employee's applicable terms. Zero disables a threshold. Duplicate approved policies for new terms.</div>
        <group><group><field name="name" readonly="state != 'draft'"/><field name="company_id" readonly="state != 'draft'" groups="base.group_multi_company"/><field name="reference" readonly="state != 'draft'"/><field name="employment_type" readonly="state != 'draft'"/></group><group><field name="notice_hours" readonly="state != 'draft'"/><field name="min_rest_hours" readonly="state != 'draft'"/><field name="weekly_hours_limit" readonly="state != 'draft'"/><field name="max_shift_hours" readonly="state != 'draft'"/><field name="min_engagement_hours" readonly="state != 'draft'"/><field name="break_after_hours" readonly="state != 'draft'"/><field name="min_unpaid_break_minutes" readonly="state != 'draft'"/></group></group><field name="approval_note" readonly="state != 'draft'" placeholder="Record the reviewed terms, reviewer, date and supporting reference…"/>
    </sheet><chatter/></form></field></record>
    <record id="action_roster_policy" model="ir.actions.act_window"><field name="name">Roster Review Policies</field><field name="res_model">binaryaid.roster.policy</field><field name="view_mode">list,form</field></record>

    <record id="view_template_list" model="ir.ui.view"><field name="name">roster.template.list</field><field name="model">binaryaid.roster.template</field><field name="arch" type="xml"><list><field name="name"/><field name="cycle_weeks"/><field name="timezone"/><field name="department_id"/><field name="policy_id"/><field name="state" widget="badge"/></list></field></record>
    <record id="view_template_form" model="ir.ui.view"><field name="name">roster.template.form</field><field name="model">binaryaid.roster.template</field><field name="arch" type="xml"><form><header><button name="action_add_workweek" string="Add Mon–Fri Starter" type="object" invisible="state != 'draft'"/><button name="action_release" string="Release Version" type="object" class="btn-primary" invisible="state != 'draft'"/><button name="action_assign" string="Assign Employees" type="object" invisible="state != 'active'"/><button name="action_new_version" string="New Version" type="object"/><button name="action_retire" string="Retire" type="object" invisible="state != 'active'"/><field name="state" widget="statusbar"/></header><sheet>
        <div class="alert alert-info" role="status">Configure once, assign to many employees. Released versions stay fixed. Cycle day 0 is Monday of week 1, 7 is Monday of week 2. Multiple rows support split shifts. Generate drafts first, then review and publish.</div>
        <group><group><field name="name" readonly="state != 'draft'"/><field name="company_id" readonly="state != 'draft'" groups="base.group_multi_company"/><field name="department_id" readonly="state != 'draft'"/><field name="policy_id" readonly="state != 'draft'" options="{'no_create': True}"/></group><group><field name="timezone" readonly="state != 'draft'"/><field name="cycle_weeks" readonly="state != 'draft'"/><field name="anchor_date" readonly="state != 'draft'"/><field name="previous_version_id"/></group></group>
        <field name="common_tasks" readonly="state != 'draft'" placeholder="One task per line, shared by every shift…"/>
        <field name="line_ids" readonly="state != 'draft'">
            <list editable="bottom" open_form_view="true"><field name="cycle_day"/><field name="cycle_label"/><field name="name"/><field name="start_hour" widget="float_time"/><field name="end_hour" widget="float_time"/><field name="end_day_offset"/><field name="unpaid_break_minutes"/><field name="location_id"/></list>
            <form string="Pattern Shift"><group><field name="name"/><field name="cycle_day"/><field name="start_hour" widget="float_time"/><field name="end_hour" widget="float_time"/><field name="end_day_offset"/><field name="unpaid_break_minutes"/><field name="location_id"/></group><group><field name="break_instructions"/><field name="instructions"/></group><separator string="Reusable task definitions (created per employee only on publication)"/><field name="task_recipe_ids"><list editable="bottom"><field name="sequence" widget="handle"/><field name="name"/><field name="description"/></list></field></form>
        </field>
    </sheet><chatter/></form></field></record>
    <record id="action_roster_template" model="ir.actions.act_window"><field name="name">Schedule Templates</field><field name="res_model">binaryaid.roster.template</field><field name="view_mode">list,form</field></record>

    <record id="view_assignment_list" model="ir.ui.view"><field name="name">roster.assignment.list</field><field name="model">binaryaid.roster.assignment</field><field name="arch" type="xml"><list decoration-muted="state == 'ended'"><field name="employee_id"/><field name="template_id"/><field name="policy_id"/><field name="department_id"/><field name="date_start"/><field name="date_end"/><field name="auto_publish"/><field name="generated_until"/><field name="state" widget="badge"/></list></field></record>
    <record id="view_assignment_search" model="ir.ui.view"><field name="name">roster.assignment.search</field><field name="model">binaryaid.roster.assignment</field><field name="arch" type="xml"><search><field name="employee_id"/><field name="template_id"/><field name="department_id"/><filter name="active" string="Active" domain="[('state', '=', 'active')]"/><group><filter name="template" string="Template" context="{'group_by': 'template_id'}"/><filter name="department" string="Department" context="{'group_by': 'department_id'}"/></group></search></field></record>
    <record id="view_assignment_form" model="ir.ui.view"><field name="name">roster.assignment.form</field><field name="model">binaryaid.roster.assignment</field><field name="arch" type="xml"><form><header><button name="action_activate" string="Activate" type="object" class="btn-primary" invisible="state != 'draft'"/><button name="action_generate" string="Generate Preview" type="object" invisible="state != 'active'"/><button name="action_end" string="End / Change Schedule" type="object" invisible="state != 'active'"/><field name="state" widget="statusbar"/></header><sheet><group><group><field name="company_id" readonly="state != 'draft'" groups="base.group_multi_company"/><field name="employee_id" readonly="state != 'draft'"/><field name="template_id" readonly="state != 'draft'"/><field name="policy_id" readonly="state != 'draft'"/><field name="department_id"/></group><group><field name="date_start" readonly="state != 'draft'"/><field name="date_end" readonly="state != 'draft'"/><field name="phase_days" readonly="state != 'draft'"/><field name="horizon_days" readonly="state != 'draft'"/><field name="auto_publish" readonly="state != 'draft'"/><field name="generated_until"/><field name="end_reason"/></group></group><div class="alert alert-info" role="status">Automatic generation maintains a rolling future horizon. Automatic publication is opt-in and requires an approved review policy. Failed publication leaves a draft and a review issue. Ending early cancels generated future shifts after the last local start date.</div><field name="shift_ids" readonly="1"><list><field name="name"/><field name="roster_occurrence_date"/><field name="start"/><field name="end"/><field name="roster_exception"/><field name="state"/></list></field></sheet><chatter/></form></field></record>
    <record id="action_roster_assignment" model="ir.actions.act_window"><field name="name">Employee Schedule Assignments</field><field name="res_model">binaryaid.roster.assignment</field><field name="view_mode">list,form</field></record>
    <record id="action_generate_assignments" model="ir.actions.server"><field name="name">Generate Roster Preview</field><field name="model_id" ref="model_binaryaid_roster_assignment"/><field name="binding_model_id" ref="model_binaryaid_roster_assignment"/><field name="binding_view_types">list</field><field name="group_ids" eval="[(4, ref('binaryaid_work_management.group_work_admin'))]"/><field name="state">code</field><field name="code">action = records.action_generate()</field></record>

    <record id="view_run_list" model="ir.ui.view"><field name="name">roster.run.list</field><field name="model">binaryaid.roster.run</field><field name="arch" type="xml"><list create="false" edit="false" delete="false"><field name="create_date"/><field name="create_uid"/><field name="source"/><field name="date_from"/><field name="date_to"/><field name="created"/><field name="skipped"/><field name="state" widget="badge"/></list></field></record>
    <record id="view_run_form" model="ir.ui.view"><field name="name">roster.run.form</field><field name="model">binaryaid.roster.run</field><field name="arch" type="xml"><form create="false" edit="false" delete="false"><header><button name="action_open_shifts" type="object" string="Review Generated Shifts" class="btn-primary"/></header><sheet><group><field name="source"/><field name="create_date"/><field name="date_from"/><field name="date_to"/><field name="created"/><field name="skipped"/><field name="state"/><field name="assignment_ids" widget="many2many_tags"/></group><separator string="Items needing review"/><field name="issue_ids"><list create="false" edit="false" delete="false"><field name="assignment_id"/><field name="date"/><field name="line_id"/><field name="shift_id"/><field name="message"/></list></field></sheet></form></field></record>
    <record id="action_roster_run" model="ir.actions.act_window"><field name="name">Generation Runs and Issues</field><field name="res_model">binaryaid.roster.run</field><field name="view_mode">list,form</field></record>
    <record id="action_roster_events" model="ir.actions.act_window"><field name="name">Roster Audit</field><field name="res_model">binaryaid.roster.event</field><field name="view_mode">list,form</field></record>
    <record id="view_employee_shift_history_list" model="ir.ui.view">
        <field name="name">roster.employee.shift.history.list</field>
        <field name="model">binaryaid.work.shift</field>
        <field name="arch" type="xml">
            <list create="false" edit="false" delete="false" default_order="start desc, id desc" decoration-muted="state == 'cancelled'">
                <field name="employee_id"/><field name="name"/><field name="start"/><field name="end"/>
                <field name="planned_hours" string="Scheduled Hours" sum="Scheduled hours"/>
                <field name="unpaid_break_minutes"/><field name="location"/><field name="state" widget="badge"/>
            </list>
        </field>
    </record>
    <record id="view_employee_shift_history_search" model="ir.ui.view">
        <field name="name">roster.employee.shift.history.search</field>
        <field name="model">binaryaid.work.shift</field>
        <field name="arch" type="xml"><search>
            <field name="employee_id"/><field name="name"/>
            <filter name="shift_date" string="Shift Date" date="start"/>
            <filter name="published" string="Published" domain="[('state', '=', 'published')]"/>
            <filter name="cancelled" string="Cancelled" domain="[('state', '=', 'cancelled')]"/>
            <group><filter name="employee" string="Employee" context="{'group_by': 'employee_id'}"/>
                <filter name="week" string="Week" context="{'group_by': 'start:week'}"/></group>
        </search></field>
    </record>
    <record id="action_employee_shift_history" model="ir.actions.server">
        <field name="name">Roster Audit</field><field name="model_id" ref="binaryaid_work_scheduling.model_binaryaid_work_shift"/>
        <field name="group_ids" eval="[(4, ref('binaryaid_work_management.group_work_admin'))]"/>
        <field name="state">code</field><field name="code">action = model.action_employee_shift_history()</field>
    </record>
    <record id="view_event_list" model="ir.ui.view"><field name="name">roster.event.list</field><field name="model">binaryaid.roster.event</field><field name="arch" type="xml"><list create="false" edit="false" delete="false"><field name="create_date"/><field name="shift_id"/><field name="employee_id"/><field name="event"/><field name="author_id"/><field name="reason"/></list></field></record>
    <record id="view_actual_list" model="ir.ui.view"><field name="name">roster.actual.list</field><field name="model">binaryaid.roster.actual</field><field name="arch" type="xml"><list create="false" edit="false" delete="false"><field name="create_date"/><field name="shift_id"/><field name="employee_id"/><field name="hours"/><field name="is_void"/><field name="reason"/><field name="author_id"/></list></field></record>
    <record id="action_roster_actual" model="ir.actions.act_window"><field name="name">Actual Work Approval History</field><field name="res_model">binaryaid.roster.actual</field><field name="view_mode">list,form</field></record>
    <menuitem id="menu_roster_root" name="Roster Planning" parent="binaryaid_work_management.menu_work_root" sequence="12" groups="binaryaid_work_management.group_work_admin"/>
    <menuitem id="menu_roster_template" name="Schedule Templates" parent="menu_roster_root" action="action_roster_template" sequence="10"/>
    <menuitem id="menu_roster_assignment" name="Employee Assignments" parent="menu_roster_root" action="action_roster_assignment" sequence="20"/>
    <menuitem id="menu_roster_run" name="Generation Runs" parent="menu_roster_root" action="action_roster_run" sequence="30"/>
    <record id="menu_roster_run" model="ir.ui.menu"><field name="active" eval="False"/></record>
    <menuitem id="menu_roster_policy" name="Review Policies" parent="menu_roster_root" action="action_roster_policy" sequence="40"/>
    <menuitem id="menu_roster_audit" name="Roster Audit" parent="menu_roster_root" action="action_employee_shift_history" sequence="50"/>
    <menuitem id="menu_roster_actual" name="Actual Work History" parent="menu_roster_root" action="action_roster_actual" sequence="60"/>
    <record id="menu_roster_actual" model="ir.ui.menu"><field name="active" eval="False"/></record>
</odoo>
