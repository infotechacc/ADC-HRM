<odoo>
    <record id="view_shift_planning_form" model="ir.ui.view"><field name="name">roster.shift.planning.form</field><field name="model">binaryaid.work.shift</field><field name="inherit_id" ref="binaryaid_work_scheduling.view_shift_form"/><field name="arch" type="xml">
        <xpath expr="//header/field[@name='state']" position="before"><button name="action_cover" string="Replace / Swap" type="object" invisible="state != 'published'" groups="binaryaid_work_management.group_work_admin"/></xpath>
    </field></record>
    <record id="view_shift_planning_list" model="ir.ui.view"><field name="name">roster.shift.planning.list</field><field name="model">binaryaid.work.shift</field><field name="inherit_id" ref="binaryaid_work_scheduling.view_shift_list"/><field name="arch" type="xml"><xpath expr="//field[@name='state']" position="before"><field name="roster_occurrence_date" optional="hide"/><field name="roster_department_id" optional="hide"/><field name="roster_location_id" optional="hide"/><field name="roster_exception" optional="show"/></xpath></field></record>
    <record id="view_shift_planning_search" model="ir.ui.view"><field name="name">roster.shift.planning.search</field><field name="model">binaryaid.work.shift</field><field name="inherit_id" ref="binaryaid_work_scheduling.view_shift_search"/><field name="arch" type="xml"><xpath expr="//search" position="inside"><field name="roster_department_id"/><field name="roster_location_id"/><filter name="exceptions" string="Employee Exceptions" domain="[('roster_exception', '=', True)]"/><group><filter name="department" string="Department" context="{'group_by': 'roster_department_id'}"/><filter name="location" string="Location" context="{'group_by': 'roster_location_id'}"/></group></xpath></field></record>
</odoo>
