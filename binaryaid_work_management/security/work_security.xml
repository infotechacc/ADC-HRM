<?xml version='1.0' encoding='UTF-8'?>
<odoo>
    <record id="rule_work_employee_company" model="ir.rule">
        <field name="name">Work employees: allowed companies</field>
        <field name="model_id" ref="model_binaryaid_work_employee"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_work_employee_owner" model="ir.rule">
        <field name="name">Work employees: self or work administrator</field>
        <field name="model_id" ref="model_binaryaid_work_employee"/>
        <field name="domain_force">[(1, '=', 1)] if user.has_group('binaryaid_work_management.group_work_admin') else [('user_id', '=', user.id)]</field>
    </record>
    <record id="privilege_work" model="res.groups.privilege">
        <field name="name">Work Management</field>
        <field name="category_id" ref="base.module_category_human_resources"/>
    </record>
    <record id="group_work_user" model="res.groups">
        <field name="name">User</field>
        <field name="privilege_id" ref="privilege_work"/>
        <field name="implied_ids" eval="[(4, ref('project.group_project_user'))]"/>
    </record>
    <record id="group_work_admin" model="res.groups">
        <field name="name">Administrator</field>
        <field name="privilege_id" ref="privilege_work"/>
        <field name="implied_ids" eval="[(4, ref('group_work_user')), (4, ref('hr.group_hr_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_admin'))]"/>
    </record>
    <!-- A global conditional rule is necessary: group rules are additive. -->
    <record id="rule_work_assignment" model="ir.rule">
        <field name="name">Employee work: assigned employee or work administrator</field>
        <field name="model_id" ref="project.model_project_task"/>
        <field name="domain_force">[(1, '=', 1)] if user.has_group('binaryaid_work_management.group_work_admin') else ['|', ('binaryaid_employee_id', '=', False), ('binaryaid_employee_id.user_id', '=', user.id)]</field>
    </record>
    <record id="rule_work_admin" model="ir.rule">
        <field name="name">Work administrators: employee assignments</field>
        <field name="model_id" ref="project.model_project_task"/>
        <field name="groups" eval="[(4, ref('group_work_admin'))]"/>
        <field name="domain_force">[('binaryaid_employee_id', '!=', False)]</field>
    </record>
    <record id="rule_work_assignee" model="ir.rule">
        <field name="name">Work users: their assignments</field>
        <field name="model_id" ref="project.model_project_task"/>
        <field name="groups" eval="[(4, ref('group_work_user'))]"/>
        <field name="domain_force">[('binaryaid_employee_id.user_id', '=', user.id)]</field>
    </record>
    <!-- SQL report models do not inherit task record rules. -->
    <record id="rule_work_task_report" model="ir.rule">
        <field name="name">Task analysis: protect employee work</field>
        <field name="model_id" ref="project.model_report_project_task_user"/>
        <field name="domain_force">[(1, '=', 1)] if user.has_group('binaryaid_work_management.group_work_admin') else ['|', ('task_id.binaryaid_employee_id', '=', False), ('task_id.binaryaid_employee_id.user_id', '=', user.id)]</field>
    </record>
    <record id="rule_log_company" model="ir.rule">
        <field name="name">Work history: allowed companies</field>
        <field name="model_id" ref="model_binaryaid_work_log"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_log_owner" model="ir.rule">
        <field name="name">Work history: own records or administrator</field>
        <field name="model_id" ref="model_binaryaid_work_log"/>
        <field name="domain_force">[(1, '=', 1)] if user.has_group('binaryaid_work_management.group_work_admin') else [('user_id', '=', user.id)]</field>
    </record>
</odoo>
