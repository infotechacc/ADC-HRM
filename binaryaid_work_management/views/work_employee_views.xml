<odoo>
    <record id="view_work_employee_list" model="ir.ui.view">
        <field name="name">binaryaid.work.employee.list</field>
        <field name="model">binaryaid.work.employee</field>
        <field name="arch" type="xml">
            <list string="Employee Work" create="false" edit="false" delete="false" action="action_open_work" type="object">
                <field name="name" string="Employee"/>
                <field name="user_id" string="ERP User"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <button name="action_open_work" type="object" string="View Daily Work" icon="fa-tasks"/>
            </list>
        </field>
    </record>
    <record id="view_work_employee_search" model="ir.ui.view">
        <field name="name">binaryaid.work.employee.search</field>
        <field name="model">binaryaid.work.employee</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" string="Employee"/>
                <filter name="archived" string="Archived Employees" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>
    <record id="action_work_employees" model="ir.actions.act_window">
        <field name="group_ids" eval="[(6, 0, [ref('group_work_admin')])]"/>
        <field name="name">Work Management</field>
        <field name="res_model">binaryaid.work.employee</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_work_employee_list"/>
        <field name="search_view_id" ref="view_work_employee_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No employee is available for your account.</p>
            <p>Ask an administrator to link your user account to your employee profile.</p>
        </field>
    </record>
    <record id="menu_work_items" model="ir.ui.menu">
        <field name="name">Employee Work</field>
        <field name="action" ref="action_work_employees"/>
        <field name="group_ids" eval="[(6, 0, [ref('group_work_admin')])]"/>
    </record>
    <record id="menu_work_history" model="ir.ui.menu">
        <field name="group_ids" eval="[(6, 0, [ref('group_work_admin')])]"/>
    </record>
    <record id="action_work_history" model="ir.actions.act_window">
        <field name="group_ids" eval="[(6, 0, [ref('group_work_admin')])]"/>
    </record>
    <record id="action_my_work" model="ir.actions.server">
        <field name="name">My Work History</field>
        <field name="model_id" ref="model_binaryaid_work_employee"/>
        <field name="group_ids" eval="[(6, 0, [ref('group_work_user')])]"/>
        <field name="state">code</field>
        <field name="code">action = model.action_my_work()</field>
    </record>
    <menuitem id="menu_my_work" name="My Work History" parent="menu_work_root"
              action="action_my_work" sequence="5" groups="group_work_user"/>
</odoo>
