<odoo>
    <record id="view_shift_list" model="ir.ui.view">
        <field name="name">binaryaid.work.shift.list</field><field name="model">binaryaid.work.shift</field>
        <field name="arch" type="xml">
            <list decoration-muted="state == 'cancelled'" decoration-info="state == 'draft'">
                <field name="name"/><field name="employee_name"/><field name="start"/><field name="end"/>
                <field name="timezone" optional="hide"/><field name="planned_hours" sum="Planned hours"/>
                <field name="location"/><field name="state" widget="badge"/><field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>
    <record id="view_shift_calendar" model="ir.ui.view">
        <field name="name">binaryaid.work.shift.calendar</field><field name="model">binaryaid.work.shift</field>
        <field name="arch" type="xml"><calendar string="Weekly Work Schedule" date_start="start" date_stop="end" color="employee_name" mode="week" event_open_popup="true" quick_create="false" create="false" edit="false" delete="false"><field name="name"/><field name="employee_name"/><field name="state"/><field name="location"/></calendar></field>
    </record>
    <record id="view_shift_form" model="ir.ui.view">
        <field name="name">binaryaid.work.shift.form</field><field name="model">binaryaid.work.shift</field>
        <field name="arch" type="xml">
            <form string="Work Shift">
                <header>
                    <button name="action_publish" type="object" string="Publish" class="btn-primary" invisible="state != 'draft'" groups="binaryaid_work_management.group_work_admin"/>
                    <button name="action_revise" type="object" string="Revise" invisible="state != 'published'" groups="binaryaid_work_management.group_work_admin"/>
                    <button name="action_cancel" type="object" string="Cancel Shift" invisible="state != 'published'" groups="binaryaid_work_management.group_work_admin"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="alert alert-info" role="status">Times display in your user timezone. The workplace timezone determines the review week. Planned hours are not attendance or payroll hours.</div>
                    <group readonly="state != 'draft'">
                        <group><field name="name" readonly="state != 'draft'"/><field name="company_id" readonly="state != 'draft'" groups="base.group_multi_company"/><field name="employee_id" readonly="state != 'draft'" groups="binaryaid_work_management.group_work_admin"/><field name="employee_name" groups="!binaryaid_work_management.group_work_admin"/><field name="location" readonly="state != 'draft'"/></group>
                        <group><field name="start" readonly="state != 'draft'"/><field name="end" readonly="state != 'draft'"/><field name="timezone" readonly="state != 'draft'"/><field name="unpaid_break_minutes" readonly="state != 'draft'"/><field name="planned_hours"/></group>
                    </group>
                    <notebook>
                        <page string="Tasks and Instructions"><field name="instructions" readonly="state != 'draft'"/><field name="break_instructions" readonly="state != 'draft'"/>
                            <field name="task_ids" readonly="state != 'draft'" context="{'default_binaryaid_employee_id': employee_id, 'default_company_id': company_id}" options="{'no_create': True}">
                                <list><field name="name" readonly="state != 'draft'"/><field name="binaryaid_work_date"/><field name="state"/></list>
                            </field>
                        </page>
                        <page string="Roster Review" groups="binaryaid_work_management.group_work_admin">
                            <p>Configure thresholds for the applicable award or agreement. Zero disables a threshold. Threshold exceptions require a recorded manager review; this does not certify legal compliance.</p>
                            <group readonly="state != 'draft'"><field name="award_reference" readonly="state != 'draft'"/><field name="notice_hours" readonly="state != 'draft'"/><field name="min_rest_hours" readonly="state != 'draft'"/><field name="weekly_hours_limit" readonly="state != 'draft'"/><field name="review_note" readonly="state != 'draft'"/></group>
                            <field name="change_reason" invisible="state != 'published'"/><field name="published_at"/>
                        </page>
                    </notebook>
                </sheet><chatter/>
            </form>
        </field>
    </record>
    <record id="view_shift_search" model="ir.ui.view">
        <field name="name">binaryaid.work.shift.search</field><field name="model">binaryaid.work.shift</field>
        <field name="arch" type="xml"><search><field name="name"/><field name="employee_name"/><filter name="mine" string="My Shifts" domain="[('user_id', '=', uid)]"/><filter name="published" string="Published" domain="[('state', '=', 'published')]"/><filter name="draft" string="Draft" domain="[('state', '=', 'draft')]"/><filter name="start" string="Shift Date" date="start"/><group><filter name="employee" string="Employee" context="{'group_by': 'employee_name'}"/><filter name="week" string="Week" context="{'group_by': 'start:week'}"/></group></search></field>
    </record>
    <record id="action_work_schedule" model="ir.actions.act_window"><field name="name">Weekly Work Schedule</field><field name="res_model">binaryaid.work.shift</field><field name="view_mode">calendar,list,form</field></record>
    <record id="action_publish_shifts" model="ir.actions.server">
        <field name="name">Publish Shifts</field>
        <field name="model_id" ref="model_binaryaid_work_shift"/>
        <field name="binding_model_id" ref="model_binaryaid_work_shift"/>
        <field name="binding_view_types">list</field>
        <field name="group_ids" eval="[(4, ref('binaryaid_work_management.group_work_admin'))]"/>
        <field name="state">code</field>
        <field name="code">records.action_publish()</field>
    </record>
    <menuitem id="menu_work_schedule" name="Weekly Work Schedule" parent="binaryaid_work_management.menu_work_root" action="action_work_schedule" groups="binaryaid_work_management.group_work_user" sequence="15"/>
</odoo>
