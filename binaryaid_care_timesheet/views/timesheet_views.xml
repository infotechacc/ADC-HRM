<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_timesheet_list" model="ir.ui.view">
        <field name="name">binaryaid.care.timesheet.list</field><field name="model">binaryaid.care.timesheet</field>
        <field name="arch" type="xml">
            <list create="false" decoration-warning="issue_count and state in ('draft', 'review')" decoration-muted="state == 'locked'">
                <field name="employee_id"/><field name="period_start"/><field name="period_end"/>
                <field name="planned_hours" widget="float_time" sum="Planned"/><field name="actual_hours" widget="float_time" sum="Actual"/>
                <field name="adjusted_hours" widget="float_time" sum="Adjusted"/><field name="approved_hours" widget="float_time" sum="Approved"/>
                <field name="issue_count" string="Issues"/><field name="state" widget="badge" decoration-info="state == 'review'" decoration-success="state in ('approved', 'locked')"/>
            </list>
        </field>
    </record>
    <record id="view_timesheet_form" model="ir.ui.view">
        <field name="name">binaryaid.care.timesheet.form</field><field name="model">binaryaid.care.timesheet</field>
        <field name="arch" type="xml">
            <form string="Fortnightly timesheet" create="false">
                <header>
                    <button name="action_refresh" type="object" string="Refresh from attendance" invisible="state not in ('draft', 'review')" groups="binaryaid_work_management.group_work_admin"/>
                    <button name="action_submit_review" type="object" string="Start review" invisible="state != 'draft'" groups="binaryaid_work_management.group_work_admin"/>
                    <button name="action_approve" type="object" string="Approve" class="btn-primary" invisible="state not in ('draft', 'review')" groups="binaryaid_work_management.group_work_admin"/>
                    <button name="action_lock" type="object" string="Lock" class="btn-primary" invisible="state != 'approved'" groups="binaryaid_work_management.group_work_admin"/>
                    <button name="action_reset_review" type="object" string="Reopen" invisible="state != 'approved'" groups="binaryaid_work_management.group_work_admin"/>
                    <button name="action_export_csv" type="object" string="Export CSV" invisible="state not in ('approved', 'locked')" groups="binaryaid_work_management.group_work_admin"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="employee_id" readonly="1"/></h1></div>
                    <group>
                        <group><field name="period_start"/><field name="period_end"/><field name="reviewer_id"/><field name="approved_on"/><field name="locked_on"/></group>
                        <group>
                            <field name="planned_hours" widget="float_time"/><field name="actual_hours" widget="float_time"/>
                            <field name="adjusted_hours" widget="float_time"/><field name="approved_hours" widget="float_time"/>
                            <field name="issue_count"/>
                        </group>
                    </group>
                    <div class="alert alert-info" role="status">Planned, actual, adjusted and approved hours are kept separately. Incomplete and unresolved rows are excluded from approved hours. This export does not run payroll.</div>
                    <field name="line_ids">
                        <list decoration-danger="status == 'unresolved'" decoration-warning="status == 'incomplete'">
                            <field name="planned_start"/><field name="client_id"/><field name="planned_hours" widget="float_time"/>
                            <field name="actual_check_in"/><field name="actual_check_out"/><field name="actual_hours" widget="float_time"/>
                            <field name="break_hours" widget="float_time" optional="hide"/>
                            <field name="effective_hours" widget="float_time"/><field name="approved_hours" widget="float_time"/>
                            <field name="note_submitted"/><field name="issues" optional="show"/><field name="adjustment_reason" optional="show"/>
                            <field name="correction_state" optional="show"/><field name="status" widget="badge" decoration-success="status == 'complete'" decoration-warning="status == 'incomplete'" decoration-danger="status == 'unresolved'"/>
                            <field name="timesheet_state" column_invisible="1"/>
                            <button name="action_adjust" type="object" icon="fa-pencil" title="Adjust hours" invisible="timesheet_state not in ('draft', 'review')" groups="binaryaid_work_management.group_work_admin"/>
                            <button name="action_request_correction" type="object" icon="fa-flag" title="Request correction" invisible="timesheet_state not in ('draft', 'review')"/>
                            <button name="action_resolve_correction" type="object" icon="fa-check" title="Mark correction resolved" invisible="correction_state != 'requested'" groups="binaryaid_work_management.group_work_admin"/>
                            <button name="action_open_shift" type="object" icon="fa-external-link" title="Open shift"/>
                        </list>
                    </field>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="view_timesheet_search" model="ir.ui.view">
        <field name="name">binaryaid.care.timesheet.search</field><field name="model">binaryaid.care.timesheet</field>
        <field name="arch" type="xml">
            <search>
                <field name="employee_id"/>
                <filter name="to_approve" string="To approve" domain="[('state', 'in', ['draft', 'review'])]"/>
                <filter name="approved" string="Approved or locked" domain="[('state', 'in', ['approved', 'locked'])]"/>
                <filter name="issues" string="With issues" domain="[('issue_count', '>', 0)]"/>
                <filter name="period" string="Fortnight" date="period_start"/>
                <group><filter name="group_period" string="Fortnight" context="{'group_by': 'period_start:day'}"/></group>
            </search>
        </field>
    </record>
    <record id="action_timesheets" model="ir.actions.act_window">
        <field name="name">Fortnightly Timesheets</field><field name="res_model">binaryaid.care.timesheet</field>
        <field name="view_mode">list,form</field><field name="context">{'search_default_to_approve': 1}</field>
        <field name="help" type="html"><p class="o_view_nocontent_smiling_face">No timesheets yet</p><p>Timesheets are prepared every day for the current and previous fortnight, or with Generate Timesheets.</p></field>
    </record>
    <record id="action_my_timesheets" model="ir.actions.act_window">
        <field name="name">My Timesheets</field><field name="res_model">binaryaid.care.timesheet</field>
        <field name="view_mode">list,form</field><field name="domain">[('user_id', '=', uid)]</field>
    </record>
    <record id="action_export_approved" model="ir.actions.server">
        <field name="name">Export approved timesheets (CSV)</field>
        <field name="model_id" ref="model_binaryaid_care_timesheet"/>
        <field name="binding_model_id" ref="model_binaryaid_care_timesheet"/>
        <field name="binding_view_types">list,form</field>
        <field name="group_ids" eval="[(4, ref('binaryaid_work_management.group_work_admin'))]"/>
        <field name="state">code</field>
        <field name="code">action = records.action_export_csv()</field>
    </record>

    <record id="view_timesheet_line_pivot" model="ir.ui.view">
        <field name="name">binaryaid.care.timesheet.line.pivot</field><field name="model">binaryaid.care.timesheet.line</field>
        <field name="arch" type="xml">
            <pivot string="Planned versus actual hours" sample="1">
                <field name="employee_id" type="row"/><field name="planned_start" interval="week" type="col"/>
                <field name="planned_hours" type="measure"/><field name="actual_hours" type="measure"/>
                <field name="effective_hours" type="measure"/><field name="approved_hours" type="measure"/>
            </pivot>
        </field>
    </record>
    <record id="view_timesheet_line_list" model="ir.ui.view">
        <field name="name">binaryaid.care.timesheet.line.list</field><field name="model">binaryaid.care.timesheet.line</field>
        <field name="arch" type="xml">
            <list create="false">
                <field name="employee_id"/><field name="client_id"/><field name="planned_start"/>
                <field name="planned_hours" widget="float_time" sum="Planned"/><field name="actual_hours" widget="float_time" sum="Actual"/>
                <field name="effective_hours" widget="float_time" sum="Adjusted"/><field name="approved_hours" widget="float_time" sum="Approved"/>
                <field name="status" widget="badge"/><field name="timesheet_state"/>
            </list>
        </field>
    </record>
    <record id="view_timesheet_line_search" model="ir.ui.view">
        <field name="name">binaryaid.care.timesheet.line.search</field><field name="model">binaryaid.care.timesheet.line</field>
        <field name="arch" type="xml">
            <search>
                <field name="employee_id"/><field name="client_id"/>
                <filter name="approved" string="Approved timesheets" domain="[('timesheet_state', 'in', ['approved', 'locked'])]"/>
                <filter name="not_complete" string="Incomplete or unresolved" domain="[('status', '!=', 'complete')]"/>
                <filter name="date" string="Shift date" date="planned_start"/>
                <group><filter name="group_employee" string="Employee" context="{'group_by': 'employee_id'}"/><filter name="group_client" string="Client" context="{'group_by': 'client_id'}"/></group>
            </search>
        </field>
    </record>
    <record id="action_report_planned_actual" model="ir.actions.act_window">
        <field name="name">Planned versus Actual Hours</field><field name="res_model">binaryaid.care.timesheet.line</field>
        <field name="view_mode">pivot,list</field>
    </record>
</odoo>
