<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.binaryaid.care.timesheet</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="binaryaid_care.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='binaryaid_care_roster']" position="inside">
                <setting string="Unpaid breaks" help="Off until ADC agrees its break and paid time rules. Planned hours already show the rostered break.">
                    <field name="binaryaid_apply_unpaid_breaks"/>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
