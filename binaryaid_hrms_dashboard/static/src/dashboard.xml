<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
<t t-name="binaryaid_hrms_dashboard.Dashboard">
    <div class="ba_dashboard h-100 overflow-auto">
        <div class="ba_dashboard_inner">
            <div t-if="state.error" class="alert alert-warning" role="alert">The dashboard could not be loaded. <button class="btn btn-link" t-on-click="load">Try again</button></div>
            <div t-if="!state.data and state.loading" class="p-5 text-center" role="status">Loading your HRMS overview…</div>
            <t t-if="state.data">
                <t t-set="d" t-value="state.data"/>
                <header class="ba_hero">
                    <div>
                        <div class="ba_eyebrow">BINARYAID HRMS <span> / </span> <t t-esc="d.company_name"/></div>
                        <h1>HRMS Dashboard</h1>
                        <p>Welcome, <t t-esc="d.user_name"/>. Here is your HR overview.</p>
                    </div>
                    <div class="ba_header_meta">
                        <span t-esc="d.today_label"/>
                        <button class="btn btn-outline-secondary" t-on-click="load" t-att-disabled="state.loading"><i class="fa fa-refresh me-2" aria-hidden="true"/>Refresh</button>
                    </div>
                </header>
                <nav class="ba_shortcuts" aria-label="HRMS shortcuts">
                    <button t-foreach="d.shortcuts" t-as="link" t-key="link.key" class="btn btn-light" t-on-click="() => this.openSection(link.key)"><i t-att-class="'fa ' + link.icon + ' me-2'" aria-hidden="true"/><t t-esc="link.label"/><i class="fa fa-angle-right ms-3" aria-hidden="true"/></button>
                </nav>
                <div class="ba_metrics">
                    <button t-foreach="d.cards" t-as="card" t-key="card.key" t-att-class="'ba_metric ba_' + card.color" t-on-click="() => this.openSection(card.key)">
                        <div class="ba_metric_top"><span t-esc="card.label"/><i t-att-class="'fa ' + card.icon" aria-hidden="true"/></div>
                        <strong t-esc="card.value"/><small t-esc="card.hint"/>
                    </button>
                </div>
                <t t-if="d.can_work">
                    <section class="ba_panel ba_progress_panel">
                        <div><div class="ba_eyebrow" t-esc="d.manager ? 'COMPANY WORK' : 'MY WORK'"/><h2>This month’s progress</h2><p class="mb-0"><t t-esc="d.month_label"/> · <t t-esc="d.month_done"/> of <t t-esc="d.month_total"/> work items completed</p></div>
                        <div class="ba_progress_wrap"><strong><t t-esc="d.completion_percent"/>%</strong><div class="progress" role="progressbar" aria-label="Monthly work completion" t-att-aria-valuenow="d.completion_percent" aria-valuemin="0" aria-valuemax="100"><div class="progress-bar" t-att-style="'width:' + d.completion_percent + '%'"/></div><small>Based on Work Date in the active company</small></div>
                    </section>
                    <section class="ba_panel ba_recent_work">
                        <div class="ba_panel_heading">
                            <div><h2>Recent work</h2><p class="mb-0 mt-1 text-muted">Latest work items, ordered by Work Date</p></div>
                            <button t-if="d.manager or d.has_employee" class="btn btn-outline-primary" t-on-click="() => this.openSection(d.manager ? 'employee_work' : 'my_work')">View all work<i class="fa fa-arrow-right ms-2" aria-hidden="true"/></button>
                        </div>
                        <div t-if="!d.recent_work.length" class="ba_empty"><i class="fa fa-list-alt" aria-hidden="true"/><p>No work items yet.</p><span>Your assigned and self-added work will appear here.</span></div>
                        <div t-else="" class="table-responsive"><table class="table ba_work_table"><thead><tr><th scope="col">Work item</th><th t-if="d.manager" scope="col">Employee</th><th scope="col">Work Date</th><th scope="col">Status</th></tr></thead><tbody><tr t-foreach="d.recent_work" t-as="work" t-key="work.id"><td><button class="btn btn-link p-0 text-start" t-on-click="() => this.openWork(work.id)" t-esc="work.name"/></td><td t-if="d.manager" class="ba_employee_cell" t-esc="work.employee"/><td class="text-nowrap" t-esc="work.date"/><td><span t-att-class="'ba_status ' + (work.done ? 'ba_done' : '')"><i t-att-class="'fa me-1 ' + (work.done ? 'fa-check-circle' : 'fa-clock-o')" aria-hidden="true"/><t t-esc="work.status"/></span></td></tr></tbody></table></div>
                    </section>
                </t>
                <div t-if="!d.can_work" class="ba_panel ba_empty"><i class="fa fa-home" aria-hidden="true"/><h2>Your HRMS overview</h2><p>Available summaries reflect your current permissions. Contact your administrator if you need Work Management access.</p></div>
            </t>
        </div>
    </div>
</t>
</templates>
