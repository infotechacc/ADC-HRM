<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

<!-- Status shown as a coloured dot and plain text, as in most scheduling products. -->
<t t-name="binaryaid_hrms_dashboard.Status">
    <span t-att-class="'ba_status ba_tone_' + tone"><span class="ba_dot" aria-hidden="true"/><t t-esc="label"/></span>
</t>

<t t-name="binaryaid_hrms_dashboard.Metrics">
    <section t-if="d.cards.length" class="ba_metrics" aria-label="Key figures">
        <button t-foreach="d.cards" t-as="card" t-key="card.key" type="button"
                t-att-class="'ba_metric' + (card.value and ['red', 'amber'].includes(card.color) ? ' is_alert ba_tone_' + card.color : '')"
                t-on-click="() => this.openCard(card)" t-att-title="card.hint">
            <span class="ba_metric_label" t-esc="card.label"/>
            <span class="ba_metric_value" t-esc="card.value"/>
            <span class="ba_metric_hint" t-esc="card.hint"/>
        </button>
    </section>
</t>

<t t-name="binaryaid_hrms_dashboard.Dashboard">
    <div class="ba_dashboard h-100 overflow-auto" t-att-aria-busy="state.loading ? 'true' : 'false'">
        <div t-if="state.error" class="alert alert-warning d-flex align-items-center justify-content-between m-3" role="alert"><span>The dashboard could not be refreshed.</span><button class="btn btn-sm btn-secondary" t-on-click="load" t-att-disabled="state.loading">Try again</button></div>
        <div t-if="!state.data and state.loading" class="ba_loading" role="status"><span class="spinner-border spinner-border-sm" aria-hidden="true"/>Loading…</div>
        <t t-if="state.data">
            <t t-set="d" t-value="state.data"/>

            <!-- ============================== Administration ============================== -->
            <t t-if="d.admin">
                <header class="ba_header">
                    <div class="ba_header_title">
                        <h1>Operations</h1>
                        <span class="ba_header_sub"><t t-esc="d.today_label"/> · <t t-esc="d.company_name"/></span>
                    </div>
                    <div class="ba_header_actions">
                        <t t-foreach="d.quick_actions" t-as="qa" t-key="qa.key">
                            <button type="button" t-att-class="'btn ' + (qa.primary ? 'btn-primary' : 'btn-secondary')" t-on-click="() => this.quick(qa.key)">
                                <t t-esc="qa.label"/><span t-if="qa.key === 'tab:client_requests' and cardValue('client_requests')" class="badge rounded-pill text-bg-danger ms-2" t-esc="cardValue('client_requests')"/>
                            </button>
                        </t>
                        <button type="button" class="btn btn-light ba_refresh" t-on-click="load" t-att-disabled="state.loading" title="Refresh" aria-label="Refresh"><i t-att-class="'fa fa-refresh' + (state.loading ? ' fa-spin' : '')" aria-hidden="true"/></button>
                    </div>
                </header>

                <div class="ba_body">
                    <t t-call="binaryaid_hrms_dashboard.Metrics"/>

                    <div class="ba_columns">
                        <main class="ba_main" aria-label="Schedule">
                            <section t-if="d.today" class="ba_card" t-ref="today">
                                <div class="ba_card_header">
                                    <h2>Today <span class="ba_count" t-esc="d.today.rows.length"/></h2>
                                    <div t-if="d.today.rows.length" class="btn-group btn-group-sm ba_segmented" role="group" aria-label="Filter today's shifts">
                                        <button t-foreach="todayFilters" t-as="filter" t-key="filter.key" type="button"
                                                t-att-class="'btn ' + (state.todayFilter === filter.key ? 'btn-secondary active' : 'btn-light')"
                                                t-att-aria-pressed="state.todayFilter === filter.key ? 'true' : 'false'"
                                                t-on-click="() => state.todayFilter = filter.key"><t t-esc="filter.label"/> <span class="ba_seg_count" t-esc="filterCount(filter)"/></button>
                                    </div>
                                    <button type="button" class="btn btn-link ms-auto" t-on-click="() => this.openSection('work_schedule')">Open calendar</button>
                                </div>
                                <div t-if="!d.today.rows.length" class="ba_empty">No shifts are rostered for today. <button type="button" class="btn btn-link p-0 align-baseline" t-on-click="() => this.quick('create_shift')">Add a shift</button></div>
                                <div t-else="" class="table-responsive">
                                    <table class="table table-sm table-hover ba_table mb-0">
                                        <thead><tr><th class="ba_col_time">Time</th><th class="ba_col_worker">Worker</th><th class="ba_col_client">Client · shift</th><th class="ba_col_place">Location</th><th class="ba_col_status">Status</th></tr></thead>
                                        <tbody>
                                            <tr t-if="!todayRows.length"><td colspan="5" class="text-muted py-3">No shifts match this filter.</td></tr>
                                            <tr t-foreach="todayRows" t-as="row" t-key="row.id" class="ba_click" t-on-click="() => this.openShift(row.id, row.employee)">
                                                <td class="ba_col_time ba_num" t-esc="row.time_label"/>
                                                <td class="text-nowrap"><span t-att-class="'ba_avatar' + (row.status === 'unfilled' ? ' is_unfilled' : '')" aria-hidden="true" t-esc="row.initials"/><span t-att-class="row.status === 'unfilled' ? 'text-danger fw-semibold' : 'fw-semibold'" t-esc="row.employee"/></td>
                                                <td class="ba_truncate"><t t-if="row.client"><t t-esc="row.client"/><span class="text-muted"> · </span></t><span class="text-muted" t-esc="row.name"/></td>
                                                <td class="ba_col_place ba_truncate text-muted" t-esc="row.location"/>
                                                <td class="ba_col_status"><t t-call="binaryaid_hrms_dashboard.Status"><t t-set="tone" t-value="row.tone"/><t t-set="label" t-value="row.status_label"/></t></td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                                <p t-if="d.today.limited" class="ba_footnote">Showing the first 60 shifts.</p>
                            </section>

                            <section t-if="d.coverage" class="ba_card">
                                <div class="ba_card_header">
                                    <h2>Next 14 days</h2>
                                    <span class="ba_card_sub" t-esc="d.coverage.period"/>
                                    <span class="ba_legend ms-auto" aria-hidden="true"><span class="ba_key is_published"/>Published<span class="ba_key is_draft"/>Draft<span class="ba_key is_unfilled"/>Unfilled</span>
                                </div>
                                <div class="ba_calendar">
                                    <div t-foreach="d.coverage.days" t-as="day" t-key="day.date" t-att-class="'ba_cal_day' + (day.today ? ' is_today' : '') + (day.past ? ' is_past' : '')">
                                        <div class="ba_cal_head">
                                            <span class="ba_cal_weekday" t-esc="day.label"/>
                                            <span class="ba_cal_date"><t t-esc="day.number"/><t t-if="day_first or day.number === 1"> <t t-esc="day.month"/></t></span>
                                            <button t-if="!day.past" type="button" class="btn btn-link ba_plan_day" t-on-click="() => this.onDayClick(day)" t-att-aria-label="'Add a shift on ' + day.date" title="Add shift"><i class="fa fa-plus" aria-hidden="true"/></button>
                                        </div>
                                        <button t-foreach="day.items.slice(0, calendarLimit)" t-as="item" t-key="item.id" type="button"
                                                t-att-class="'ba_cal_item' + (item.unfilled ? ' is_unfilled' : item.state === 'draft' ? ' is_draft' : ' is_published')"
                                                t-on-click="() => this.openShift(item.id, item.title)" t-att-title="item.time + ' ' + (item.unfilled ? 'Unfilled' : item.worker) + (item.client ? ' · ' + item.client : '')">
                                            <span class="ba_cal_line"><span class="ba_num" t-esc="item.time"/> <t t-esc="item.unfilled ? 'Unfilled' : item.worker"/></span>
                                            <span t-if="item.client" class="ba_cal_client" t-esc="item.client"/>
                                        </button>
                                        <button t-if="day.items.length > calendarLimit" type="button" class="ba_cal_more" t-on-click="() => this.openSection('work_schedule')">+<t t-esc="day.items.length - calendarLimit"/> more</button>
                                    </div>
                                </div>
                            </section>

                            <section t-if="d.can_work and d.recent_work.length" class="ba_card">
                                <div class="ba_card_header"><h2>Recent work items</h2><button t-if="d.manager or d.has_employee" type="button" class="btn btn-link ms-auto" t-on-click="() => this.openSection(d.manager ? 'employee_work' : 'my_work')">View all</button></div>
                                <table class="table table-sm table-hover ba_table ba_work_table mb-0">
                                    <thead><tr><th>Work item</th><th t-if="d.manager">Employee</th><th>Date</th><th class="ba_col_status">Status</th></tr></thead>
                                    <tbody><tr t-foreach="d.recent_work" t-as="work" t-key="work.id" class="ba_click" t-on-click="() => this.openWork(work.id)">
                                        <td class="ba_truncate fw-semibold" t-esc="work.name"/><td t-if="d.manager" class="text-muted" t-esc="work.employee"/><td class="text-muted text-nowrap" t-esc="work.date"/>
                                        <td class="ba_col_status"><t t-call="binaryaid_hrms_dashboard.Status"><t t-set="tone" t-value="work.done ? 'green' : 'amber'"/><t t-set="label" t-value="work.status"/></t></td>
                                    </tr></tbody>
                                </table>
                            </section>
                        </main>

                        <aside class="ba_side" aria-label="Action items">
                            <section t-if="d.attention.length" class="ba_card ba_inbox" t-ref="attention">
                                <div class="ba_card_header"><h2>Action items <span t-if="attentionTotal" class="ba_count" t-esc="attentionTotal"/></h2></div>
                                <div t-if="!openTabs.length" class="ba_empty">Nothing needs your attention.</div>
                                <div t-foreach="openTabs" t-as="tab" t-key="tab.key" t-att-class="'ba_group' + (state.tab === tab.key ? ' is_open' : '')">
                                    <button type="button" class="ba_group_head" t-att-data-tab="tab.key" t-att-aria-expanded="state.tab === tab.key ? 'true' : 'false'" t-on-click="() => this.selectTab(tab.key)">
                                        <i t-att-class="'fa fa-fw ' + (state.tab === tab.key ? 'fa-angle-down' : 'fa-angle-right')" aria-hidden="true"/>
                                        <span class="ba_group_label" t-esc="tab.label"/>
                                        <span class="ba_count" t-esc="tab.count"/>
                                    </button>
                                    <ul t-if="state.tab === tab.key" class="ba_items">
                                        <li t-foreach="tab.items" t-as="item" t-key="item.source + item.id" class="ba_inbox_item">
                                            <div class="ba_item_text">
                                                <span class="ba_item_title" t-esc="item.title"/>
                                                <span class="ba_item_sub" t-esc="item.subtitle"/>
                                                <span class="ba_item_meta" t-esc="item.meta"/>
                                                <span t-if="item.warning" class="ba_item_warning"><i class="fa fa-exclamation-triangle me-1" aria-hidden="true"/><t t-esc="item.warning"/></span>
                                            </div>
                                            <div class="ba_item_actions">
                                                <button t-foreach="item.actions" t-as="act" t-key="act.name" type="button"
                                                        t-att-class="'btn btn-sm ' + (act.style === 'success' ? 'btn-primary ba_act_success' : act.style === 'danger' ? 'btn-light text-danger' : 'btn-light')"
                                                        t-att-disabled="state.busy" t-on-click="() => this.itemAction(item, act)" t-att-aria-label="act.label + ': ' + item.title">
                                                    <span t-if="isBusy(item, act)" class="spinner-border spinner-border-sm me-1" aria-hidden="true"/><t t-esc="act.label"/>
                                                </button>
                                            </div>
                                        </li>
                                        <li class="ba_items_footer"><button type="button" class="btn btn-link p-0" t-on-click="() => this.openSection(tab.key)">View all <t t-esc="tab.count"/></button></li>
                                    </ul>
                                </div>
                                <p t-if="clearTabs.length" class="ba_clear"><i class="fa fa-check text-success me-1" aria-hidden="true"/>Clear: <t t-esc="clearTabs.map((t) => t.label).join(', ')"/></p>
                            </section>
                            <section class="ba_card ba_goto">
                                <div class="ba_card_header"><h2>Go to</h2></div>
                                <nav class="ba_links" aria-label="Go to">
                                    <button t-foreach="d.shortcuts" t-as="link" t-key="link.key" type="button" class="ba_link" t-on-click="() => this.openSection(link.key)"><t t-esc="link.label"/><i class="fa fa-angle-right" aria-hidden="true"/></button>
                                </nav>
                            </section>
                        </aside>
                    </div>
                </div>
            </t>

            <!-- ============================== Worker app ============================== -->
            <t t-else="">
                <div class="ba_app">
                    <header class="ba_app_header">
                        <div>
                            <span class="ba_header_sub" t-esc="d.today_label"/>
                            <h1 t-esc="d.user_name"/>
                        </div>
                        <button type="button" class="btn btn-light ba_refresh" t-on-click="load" t-att-disabled="state.loading" title="Refresh" aria-label="Refresh"><i t-att-class="'fa fa-refresh' + (state.loading ? ' fa-spin' : '')" aria-hidden="true"/></button>
                    </header>

                    <div class="ba_worker_actions_slot"/>
                    <section t-if="(d.schedule or d.presence) and !(d.clock and d.clock.action)" class="ba_card ba_shift_now">
                        <t t-set="focus" t-value="d.schedule and (d.schedule.active or d.schedule.next)"/>
                        <span class="ba_eyebrow"><t t-if="d.schedule and d.schedule.active">On shift now</t><t t-elif="focus">Next shift</t><t t-else="">Your roster</t></span>
                        <t t-if="focus">
                            <strong class="ba_shift_now_title" t-esc="focus.client or focus.name"/>
                            <span class="ba_shift_now_line"><t t-esc="focus.day"/> <t t-esc="focus.day_number"/> · <t t-esc="focus.time_label"/></span>
                            <span t-if="focus.address or focus.location" class="ba_shift_now_line text-muted" t-esc="focus.address or focus.location"/>
                        </t>
                        <span t-else="" class="ba_shift_now_line text-muted">No published shifts in the next two weeks.</span>
                        <span t-if="d.presence" class="ba_shift_now_line"><t t-call="binaryaid_hrms_dashboard.Status"><t t-set="tone" t-value="d.presence.checked_in ? 'green' : 'muted'"/><t t-set="label" t-value="d.presence.checked_in ? 'Signed in since ' + d.presence.since : 'Not signed in'"/></t></span>
                    </section>

                    <div t-if="d.quick_actions.length" class="ba_app_buttons">
                        <button t-foreach="d.quick_actions" t-as="qa" t-key="qa.key" type="button" class="btn btn-secondary" t-on-click="() => this.quick(qa.key)"><i t-att-class="'fa me-2 ' + qa.icon" aria-hidden="true"/><t t-esc="qa.label"/></button>
                    </div>

                    <nav class="ba_card ba_menu ba_tiles" aria-label="Menu">
                        <button t-foreach="d.worker_nav or d.shortcuts" t-as="link" t-key="link.key" type="button" class="ba_menu_row" t-on-click="() => this.openSection(link.key)">
                            <i t-att-class="'fa fa-fw ' + link.icon" aria-hidden="true"/><span class="ba_menu_label" t-esc="link.label"/>
                            <span t-if="link.badge" class="badge rounded-pill text-bg-primary" t-esc="link.badge"/>
                            <i class="fa fa-angle-right ba_menu_chevron" aria-hidden="true"/>
                        </button>
                    </nav>

                    <div class="ba_worker_panels_slot"/>

                    <section t-if="d.schedule" class="ba_card ba_agenda">
                        <div class="ba_card_header"><h2>Upcoming shifts</h2><button type="button" class="btn btn-link ms-auto" t-on-click="() => this.openSection('work_schedule')">Open calendar</button></div>
                        <div t-if="!upcomingShifts.length" class="ba_empty">No published shifts in the next two weeks. Your coordinator publishes shifts here. Check Team messages, or request leave if you are unavailable.</div>
                        <div t-foreach="upcomingShifts" t-as="shift" t-key="shift.id" class="ba_shift_card ba_click" role="button" tabindex="0" t-on-click="() => this.navigate('open_shift', shift.id)">
                            <span class="ba_agenda_date"><span t-esc="shift.day"/><strong t-esc="shift.day_number"/></span>
                            <span class="ba_agenda_body">
                                <span class="ba_agenda_title" t-esc="shift.client or shift.name"/>
                                <span class="ba_agenda_line ba_num"><t t-esc="shift.time_label"/><t t-if="shift.unpaid_break_minutes"> · <t t-esc="shift.unpaid_break_minutes"/> min break</t></span>
                                <span t-if="shift.address or shift.location" class="ba_agenda_line" t-esc="shift.address or shift.location"/>
                                <span t-if="shift.plan" class="ba_agenda_plan" t-esc="shift.plan"/>
                            </span>
                            <span class="ba_agenda_side">
                                <t t-call="binaryaid_hrms_dashboard.Status"><t t-set="tone" t-value="shift.tone"/><t t-set="label" t-value="shift.status_label"/></t>
                                <a t-if="shift.map_url" t-att-href="shift.map_url" target="_blank" rel="noopener" class="ba_directions" t-on-click.stop="noop">Directions</a>
                            </span>
                        </div>
                        <p t-if="d.schedule.preview_limited" class="ba_footnote">Showing the first 100 shifts.</p>
                    </section>

                    <section t-if="d.my_leave" class="ba_card">
                        <div class="ba_card_header"><h2>My leave</h2><button type="button" class="btn btn-link ms-auto" t-on-click="() => this.openSection('my_leave')">All requests</button></div>
                        <div t-if="!d.my_leave.length" class="ba_empty">No upcoming or pending leave.</div>
                        <div t-foreach="d.my_leave" t-as="leave" t-key="leave.id" class="ba_list_row">
                            <span class="ba_list_main"><span class="fw-semibold" t-esc="leave.type"/><span class="text-muted ba_num"><t t-esc="leave.dates"/> · <t t-esc="leave.duration"/></span></span>
                            <t t-call="binaryaid_hrms_dashboard.Status"><t t-set="tone" t-value="leave.tone"/><t t-set="label" t-value="leave.state"/></t>
                            <button t-if="leave.can_cancel" type="button" class="btn btn-sm btn-light" t-att-disabled="state.busy" t-on-click="() => this.cancelLeave(leave)">Cancel</button>
                        </div>
                    </section>

                    <section t-if="d.can_work and d.recent_work.length" class="ba_card">
                        <div class="ba_card_header"><h2>My work items</h2><button t-if="d.has_employee" type="button" class="btn btn-link ms-auto" t-on-click="() => this.openSection('my_work')">View all</button></div>
                        <table class="table table-sm ba_table ba_work_table mb-0"><tbody>
                            <tr t-foreach="d.recent_work" t-as="work" t-key="work.id" class="ba_click" t-on-click="() => this.openWork(work.id)">
                                <td class="ba_truncate" t-esc="work.name"/><td class="text-muted text-nowrap" t-esc="work.date"/>
                                <td class="ba_col_status"><t t-call="binaryaid_hrms_dashboard.Status"><t t-set="tone" t-value="work.done ? 'green' : 'amber'"/><t t-set="label" t-value="work.status"/></t></td>
                            </tr>
                        </tbody></table>
                    </section>
                </div>
            </t>
        </t>
    </div>
</t>
</templates>
