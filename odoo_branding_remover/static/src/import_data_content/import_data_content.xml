<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-inherit="ImportDataContent" t-inherit-mode="extension">
        <xpath expr="//thead/tr/th[2]" position="replace">
            <th scope="col">Field</th>
        </xpath>

        <xpath expr="//p[contains(@class, 'alert-info')]" position="replace">
            <p class="alert alert-info mb-0">
                If the file contains column names, matching fields can be detected automatically.
                This makes imports simpler, especially when the file has many columns.
            </p>
        </xpath>
    </t>
</templates>
