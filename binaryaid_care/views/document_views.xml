<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_document_category_list" model="ir.ui.view">
        <field name="name">binaryaid.care.document.category.list</field><field name="model">binaryaid.care.document.category</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/><field name="name"/><field name="applies_to"/>
                <field name="requires_expiry"/><field name="expiry_alert_days"/><field name="required"/><field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>
    <record id="action_document_category" model="ir.actions.act_window">
        <field name="name">Document Categories</field><field name="res_model">binaryaid.care.document.category</field>
        <field name="view_mode">list</field><field name="context">{'active_test': False}</field>
        <field name="help" type="html"><p class="o_view_nocontent_smiling_face">Define the client and worker document categories supplied by ADC.</p></field>
    </record>

    <record id="view_document_version_list" model="ir.ui.view">
        <field name="name">binaryaid.care.document.version.list</field><field name="model">binaryaid.care.document.version</field>
        <field name="arch" type="xml">
            <list create="false" delete="false" decoration-muted="state == 'rejected'" decoration-warning="state == 'submitted'">
                <field name="version"/><field name="file_name"/><field name="issue_date" optional="hide"/><field name="expiry_date"/>
                <field name="uploaded_by_id"/><field name="create_date" string="Uploaded on"/><field name="state" widget="badge"/>
                <field name="reviewed_by_id" optional="hide"/><field name="review_note" optional="hide"/>
                <button name="action_preview" type="object" string="Preview" icon="fa-eye"/>
                <button name="action_download" type="object" string="Download" icon="fa-download"/>
                <button name="action_approve" type="object" string="Approve" icon="fa-check" invisible="state != 'submitted'"/>
                <button name="action_reject" type="object" string="Reject" icon="fa-times" invisible="state != 'submitted'"/>
            </list>
        </field>
    </record>

    <record id="view_care_document_list" model="ir.ui.view">
        <field name="name">binaryaid.care.document.list</field><field name="model">binaryaid.care.document</field>
        <field name="arch" type="xml">
            <list create="false" decoration-danger="expiry_state == 'expired'" decoration-warning="expiry_state == 'expiring'" decoration-muted="expiry_state == 'missing'">
                <field name="category_id"/><field name="client_id" optional="show"/><field name="employee_id" optional="show"/>
                <field name="version_count" string="Versions"/><field name="pending_version_count" string="Awaiting approval" optional="show"/>
                <field name="expiry_date"/><field name="expiry_state" widget="badge" decoration-success="expiry_state == 'valid'" decoration-warning="expiry_state == 'expiring'" decoration-danger="expiry_state == 'expired'"/>
                <button name="action_upload" type="object" string="Upload" icon="fa-upload"/>
                <button name="action_preview" type="object" string="Preview" icon="fa-eye" invisible="not current_version_id"/>
                <field name="current_version_id" column_invisible="1"/>
            </list>
        </field>
    </record>
    <record id="view_care_document_form" model="ir.ui.view">
        <field name="name">binaryaid.care.document.form</field><field name="model">binaryaid.care.document</field>
        <field name="arch" type="xml">
            <form string="Document">
                <header>
                    <button name="action_upload" type="object" string="Upload new version" class="btn-primary"/>
                    <button name="action_preview" type="object" string="Preview current" invisible="not current_version_id"/>
                    <field name="expiry_state" widget="statusbar" statusbar_visible="missing,valid,expiring,expired"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name" placeholder="Document name"/></h1></div>
                    <group>
                        <group><field name="category_id" options="{'no_create': True}" readonly="id"/><field name="client_id" invisible="not client_id" readonly="1"/><field name="employee_id" invisible="not employee_id" readonly="1"/></group>
                        <group><field name="current_version_id" readonly="1"/><field name="expiry_date"/><field name="alert_date" string="Alert from"/><field name="company_id" groups="base.group_multi_company"/></group>
                    </group>
                    <div class="alert alert-warning" role="alert" invisible="not retention_due">This record is past the configured retention period. Review it before any disposal.</div>
                    <field name="retention_due" invisible="1"/>
                    <notebook>
                        <page string="Version history" name="versions">
                            <field name="version_ids" readonly="1" context="{'list_view_ref': 'binaryaid_care.view_document_version_list'}"/>
                        </page>
                        <page string="Access log" name="access" groups="hr.group_hr_user,binaryaid_work_management.group_work_admin">
                            <field name="access_log_ids" readonly="1">
                                <list><field name="create_date" string="When"/><field name="user_id"/><field name="action"/><field name="version_id"/><field name="ip_address"/></list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="view_care_document_search" model="ir.ui.view">
        <field name="name">binaryaid.care.document.search</field><field name="model">binaryaid.care.document</field>
        <field name="arch" type="xml">
            <search>
                <field name="category_id"/><field name="client_id"/><field name="employee_id"/>
                <filter name="exceptions" string="Missing, expiring or expired" domain="[('expiry_state', 'in', ['missing', 'expiring', 'expired'])]"/>
                <filter name="expired" string="Expired" domain="[('expiry_state', '=', 'expired')]"/>
                <filter name="pending" string="Awaiting approval" domain="[('pending_version_count', '>', 0)]"/>
                <separator/>
                <filter name="clients" string="Client documents" domain="[('client_id', '!=', False)]"/>
                <filter name="workers" string="Worker documents" domain="[('employee_id', '!=', False)]"/>
                <filter name="retention" string="Retention review due" domain="[('retention_due', '=', True)]"/>
                <group><filter name="group_category" string="Category" context="{'group_by': 'category_id'}"/></group>
            </search>
        </field>
    </record>
    <record id="action_care_documents" model="ir.actions.act_window">
        <field name="name">Document Exceptions</field><field name="res_model">binaryaid.care.document</field>
        <field name="view_mode">list,form</field><field name="context">{'search_default_exceptions': 1}</field>
    </record>
    <record id="action_my_documents" model="ir.actions.act_window">
        <field name="name">My Documents</field><field name="res_model">binaryaid.care.document</field>
        <field name="view_mode">list,form</field><field name="domain">[('employee_id.user_id', '=', uid)]</field>
        <field name="help" type="html"><p>Your worker documents appear here once HR prepares them. Upload renewals for HR approval.</p></field>
    </record>
</odoo>
