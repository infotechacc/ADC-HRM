<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_client_request_list" model="ir.ui.view">
        <field name="name">binaryaid.care.client.request.list</field><field name="model">binaryaid.care.client.request</field>
        <field name="arch" type="xml">
            <list decoration-muted="state in ('declined', 'cancelled')" decoration-warning="state == 'submitted'">
                <field name="name"/><field name="client_id"/><field name="preferred_date_from"/><field name="preferred_date_to" optional="hide"/>
                <field name="preferred_start_time" widget="float_time"/><field name="preferred_end_time" widget="float_time"/>
                <field name="location_id" optional="show"/><field name="requested_by_id" optional="hide"/>
                <field name="shift_count" string="Shifts"/><field name="state" widget="badge" decoration-warning="state in ('submitted', 'in_review')" decoration-success="state in ('approved', 'scheduled')"/>
            </list>
        </field>
    </record>
    <record id="view_client_request_form" model="ir.ui.view">
        <field name="name">binaryaid.care.client.request.form</field><field name="model">binaryaid.care.client.request</field>
        <field name="arch" type="xml">
            <form string="Client request">
                <header>
                    <button name="action_start_review" type="object" string="Start review" invisible="state != 'submitted'"/>
                    <button name="action_approve" type="object" string="Approve" class="btn-primary" invisible="state not in ('submitted', 'in_review')"/>
                    <button name="action_create_shift" type="object" string="Create shift" class="btn-primary" invisible="state not in ('approved', 'scheduled')"/>
                    <button name="action_decline" type="object" string="Decline" invisible="state not in ('submitted', 'in_review', 'approved')"/>
                    <button name="action_cancel" type="object" string="Cancel request" invisible="state not in ('submitted', 'in_review')"/>
                    <field name="state" widget="statusbar" statusbar_visible="submitted,in_review,approved,scheduled"/>
                </header>
                <sheet>
                    <div name="button_box" class="oe_button_box">
                        <button name="action_open_shifts" type="object" class="oe_stat_button" icon="fa-calendar" invisible="not shift_count"><field name="shift_count" widget="statinfo" string="Shifts"/></button>
                    </div>
                    <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                    <group>
                        <group string="Client"><field name="client_id" readonly="state != 'submitted'" options="{'no_create': True}"/><field name="contact_id" options="{'no_create': True}"/><field name="requested_by_id"/></group>
                        <group string="Preferred time"><field name="preferred_date_from"/><field name="preferred_date_to"/><field name="preferred_start_time" widget="float_time"/><field name="preferred_end_time" widget="float_time"/></group>
                    </group>
                    <group>
                        <group string="Location"><field name="location_id" options="{'no_create': True}" context="{'short_location': True}"/><field name="location_note"/></group>
                        <group string="Decision"><field name="reviewer_id"/><field name="review_note" placeholder="Shown to the client. Required when declining."/></group>
                    </group>
                    <group string="Support needs"><field name="support_needs" nolabel="1" colspan="2"/></group>
                    <group string="Instructions"><field name="instructions" nolabel="1" colspan="2"/></group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="view_client_request_search" model="ir.ui.view">
        <field name="name">binaryaid.care.client.request.search</field><field name="model">binaryaid.care.client.request</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/><field name="client_id"/>
                <filter name="to_review" string="To review" domain="[('state', 'in', ['submitted', 'in_review'])]"/>
                <filter name="to_schedule" string="Approved, not scheduled" domain="[('state', '=', 'approved')]"/>
                <filter name="preferred" string="Preferred date" date="preferred_date_from"/>
                <group><filter name="group_client" string="Client" context="{'group_by': 'client_id'}"/><filter name="group_state" string="Status" context="{'group_by': 'state'}"/></group>
            </search>
        </field>
    </record>
    <record id="action_client_requests" model="ir.actions.act_window">
        <field name="name">Client Requests</field><field name="res_model">binaryaid.care.client.request</field>
        <field name="view_mode">list,form</field><field name="context">{'search_default_to_review': 1}</field>
    </record>
</odoo>
