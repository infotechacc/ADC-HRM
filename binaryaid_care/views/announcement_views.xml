<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_announcement_list" model="ir.ui.view">
        <field name="name">binaryaid.care.announcement.list</field><field name="model">binaryaid.care.announcement</field>
        <field name="arch" type="xml">
            <list decoration-muted="state == 'archived'">
                <field name="title"/><field name="audience"/><field name="author_id"/><field name="sent_on"/>
                <field name="recipient_count" string="Recipients"/><field name="read_count" string="Read"/><field name="ack_count" string="Acknowledged"/>
                <field name="state" widget="badge" decoration-success="state == 'sent'"/>
            </list>
        </field>
    </record>
    <record id="view_announcement_form" model="ir.ui.view">
        <field name="name">binaryaid.care.announcement.form</field><field name="model">binaryaid.care.announcement</field>
        <field name="arch" type="xml">
            <form string="Team message">
                <header>
                    <button name="action_send" type="object" string="Send" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_archive_message" type="object" string="Archive" invisible="state != 'sent'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="title" placeholder="Short, non-sensitive title" readonly="state != 'draft'"/></h1></div>
                    <group>
                        <group><field name="audience" readonly="state != 'draft'"/>
                            <field name="employee_ids" widget="many2many_tags" invisible="audience != 'employees'" readonly="state != 'draft'"/>
                            <field name="department_ids" widget="many2many_tags" invisible="audience != 'departments'" readonly="state != 'draft'"/></group>
                        <group><field name="requires_ack" readonly="state != 'draft'"/><field name="confirm_no_sensitive" readonly="state != 'draft'"/><field name="sent_on"/></group>
                    </group>
                    <div class="alert alert-info" role="status" invisible="state != 'draft'">Keep client care, health and incident details out of team messages. Notifications only say that a new message is waiting.</div>
                    <field name="body" readonly="state != 'draft'"/>
                    <notebook invisible="state == 'draft'">
                        <page string="Delivery">
                            <field name="recipient_ids" readonly="1">
                                <list><field name="employee_id"/><field name="read_on"/><field name="acknowledged_on"/></list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="view_announcement_read_form" model="ir.ui.view">
        <field name="name">binaryaid.care.announcement.read</field><field name="model">binaryaid.care.announcement</field>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <form string="Team message" create="false" edit="false" delete="false">
                <sheet>
                    <h2><field name="title" readonly="1"/></h2>
                    <div class="text-muted mb-3"><field name="author_id" readonly="1"/> · <field name="sent_on" readonly="1"/></div>
                    <field name="body" readonly="1"/>
                    <field name="requires_ack" invisible="1"/>
                </sheet>
                <footer>
                    <button name="action_acknowledge" type="object" string="Acknowledge" class="btn-primary" invisible="not requires_ack"/>
                    <button string="Close" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_announcements" model="ir.actions.act_window">
        <field name="name">Team Messages</field><field name="res_model">binaryaid.care.announcement</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="action_my_announcements" model="ir.actions.act_window">
        <field name="name">My Team Messages</field><field name="res_model">binaryaid.care.announcement</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state', '=', 'sent'), ('recipient_ids.user_id', '=', uid)]</field>
        <field name="views" eval="[(ref('view_announcement_list'), 'list'), (ref('view_announcement_read_form'), 'form')]"/>
    </record>
</odoo>
