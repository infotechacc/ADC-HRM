<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Plans: a name only. -->
    <record id="view_care_plan_list" model="ir.ui.view">
        <field name="name">binaryaid.care.plan.list</field><field name="model">binaryaid.care.plan</field>
        <field name="arch" type="xml">
            <list string="Plans"><field name="name"/><field name="line_ids" widget="many2many_tags" string="Services"/></list>
        </field>
    </record>
    <record id="view_care_plan_form" model="ir.ui.view">
        <field name="name">binaryaid.care.plan.form</field><field name="model">binaryaid.care.plan</field>
        <field name="arch" type="xml">
            <form string="Plan">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Morning routine"/></h1>
                    </div>
                    <separator string="Services included in this plan"/>
                    <field name="line_ids">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="name" placeholder="e.g. Personal care, shower assistance"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_care_plan" model="ir.actions.act_window">
        <field name="name">Plans</field><field name="res_model">binaryaid.care.plan</field>
        <field name="view_mode">list,form</field><field name="path">care-plans</field>
        <field name="help" type="html"><p class="o_view_nocontent_smiling_face">Create your first care plan</p><p>Enter a plan name and add the services it includes. Plans can then be assigned to clients.</p></field>
    </record>

    <!-- Clients: one simple form. -->
    <record id="view_care_client_list" model="ir.ui.view">
        <field name="name">binaryaid.care.client.list</field><field name="model">binaryaid.care.client</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/><field name="phone"/><field name="email"/><field name="service_location"/>
                <field name="plan_ids" widget="many2many_tags" optional="show"/>
            </list>
        </field>
    </record>
    <record id="view_care_client_form" model="ir.ui.view">
        <field name="name">binaryaid.care.client.form</field><field name="model">binaryaid.care.client</field>
        <field name="arch" type="xml">
            <form string="Client">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <field name="active" invisible="1"/><field name="company_id" invisible="1"/>
                    <group>
                        <group string="Client">
                            <field name="name" placeholder="Client name"/>
                            <field name="phone" widget="phone"/>
                            <field name="email" widget="email"/>
                        </group>
                        <group string="Service location">
                            <field name="service_location" placeholder="Address"/>
                            <field name="latitude"/>
                            <field name="longitude"/>
                            <field name="timezone"/>
                            <field name="radius_m"/>
                        </group>
                    </group>
                    <separator string="Alternative contacts"/>
                    <field name="contact_ids" context="{'default_client_id': id}">
                        <list editable="bottom"><field name="name"/><field name="phone" widget="phone"/><field name="email" widget="email"/></list>
                    </field>
                    <notebook>
                        <page string="Care Plans" name="plans">
                            <field name="plan_ids">
                                <list><field name="name"/><field name="line_ids" widget="many2many_tags" string="Services"/></list>
                            </field>
                        </page>
                        <page string="Documents" name="documents">
                            <field name="document_ids" context="{'default_client_id': id}">
                                <list>
                                    <field name="name" string="Document"/>
                                    <field name="create_date" string="Uploaded on" readonly="1"/>
                                    <field name="create_uid" string="Uploaded by" readonly="1"/>
                                    <button name="action_preview" type="object" string="Preview" icon="fa-eye" invisible="not id"/>
                                    <button name="action_download" type="object" string="Download" icon="fa-download" invisible="not id"/>
                                </list>
                                <form string="Upload document">
                                    <group><field name="file" filename="name"/><field name="name" invisible="1"/></group>
                                </form>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_care_client_search" model="ir.ui.view">
        <field name="name">binaryaid.care.client.search</field><field name="model">binaryaid.care.client</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/><field name="plan_ids"/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>
    <record id="action_care_client" model="ir.actions.act_window">
        <field name="name">Clients</field><field name="res_model">binaryaid.care.client</field>
        <field name="view_mode">list,form</field><field name="path">care-clients</field>
        <field name="help" type="html"><p class="o_view_nocontent_smiling_face">Add your first client</p><p>Keep each client's contacts, service location, care plans and documents in one place.</p></field>
    </record>
</odoo>
