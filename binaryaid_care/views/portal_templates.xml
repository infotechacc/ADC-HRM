<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Odoo's own /my page: the Support requests tile is always shown to authorised contacts. -->
    <template id="portal_my_home_care" inherit_id="portal.portal_my_home" priority="45">
        <xpath expr="//div[hasclass('o_portal_docs')]" position="before">
            <t t-set="portal_client_category_enable" t-value="True"/>
        </xpath>
        <div id="portal_client_category" position="inside">
            <t t-call="portal.portal_docs_entry">
                <t t-set="icon" t-value="'/web/static/img/folder.svg'"/>
                <t t-set="title">Support requests</t>
                <t t-set="url" t-value="'/my/support-requests'"/>
                <t t-set="text">Request support and follow the status of your requests</t>
                <t t-set="placeholder_count" t-value="'care_request_count'"/>
                <t t-set="config_card" t-value="care_is_contact"/>
            </t>
        </div>
    </template>

    <!-- ============================================================ ADC branding for all portal pages -->
    <template id="frontend_layout_adc" inherit_id="portal.frontend_layout" priority="60">
        <xpath expr="//div[@id='wrapwrap']" position="attributes">
            <attribute name="t-attf-class" add="adc_client adc_site" separator=" "/>
        </xpath>
        <xpath expr="//nav[hasclass('navbar')]" position="attributes">
            <attribute name="class">navbar navbar-expand adc_top</attribute>
        </xpath>
        <xpath expr="//nav[hasclass('navbar')]/div[hasclass('container')]" position="attributes">
            <attribute name="class">container adc_wrap adc_top_inner</attribute>
        </xpath>
        <xpath expr="//a[hasclass('navbar-brand')]" position="replace">
            <a href="/my" class="adc_brand">
                <span class="adc_logo">ADC</span>
                <span class="adc_brand_text"><strong>Australian Diversity Care</strong><small>My account</small></span>
            </a>
        </xpath>
        <xpath expr="//ul[@id='top_menu']" position="before">
            <t t-set="adc_path" t-value="request.httprequest.path"/>
            <nav t-if="not request.env.user._is_public()" class="adc_nav" aria-label="Main">
                <a href="/my" t-att-class="'adc_nav_link' + (' is_active' if adc_path in ('/my', '/my/home') else '')"><i class="fa fa-home" aria-hidden="true"/> My account</a>
                <t t-if="request.env['binaryaid.care.client.contact'].sudo().search_count([('user_id', '=', request.env.uid), ('is_authorised', '=', True)])">
                    <a href="/my/support-requests" t-att-class="'adc_nav_link' + (' is_active' if adc_path.startswith('/my/support-requests') and adc_path != '/my/support-requests/new' else '')"><i class="fa fa-list-ul" aria-hidden="true"/> Support requests</a>
                    <a href="/my/support-requests/new" t-att-class="'adc_nav_link' + (' is_active' if adc_path == '/my/support-requests/new' else '')"><i class="fa fa-plus-circle" aria-hidden="true"/> New request</a>
                </t>
                <a href="/my/security" t-att-class="'adc_nav_link' + (' is_active' if adc_path == '/my/security' else '')"><i class="fa fa-lock" aria-hidden="true"/> Security</a>
                <a t-if="request.env.user._is_internal()" href="/odoo" class="adc_nav_link"><i class="fa fa-th-large" aria-hidden="true"/> Back to HRMS</a>
            </nav>
        </xpath>
    </template>

    <template id="user_dropdown_adc" inherit_id="portal.user_dropdown" priority="60">
        <xpath expr="//a[@id='o_backend_user_dropdown_link']" position="replace">
            <a groups="base.group_user" href="/odoo" role="menuitem" class="dropdown-item ps-3" id="o_backend_user_dropdown_link"><i class="fa fa-fw fa-th-large me-1 small"/> Back to HRMS</a>
        </xpath>
    </template>

    <!-- Builds on odoo_branding_remover (record sidebar, promotion text): drop the empty
         promotion block and name the browser tab after ADC on portal pages. -->
    <template id="brand_promotion_adc" inherit_id="web.brand_promotion" priority="60">
        <xpath expr="//div[hasclass('o_brand_promotion')]" position="replace"/>
    </template>
    <template id="layout_title_adc" inherit_id="web.layout" priority="60">
        <xpath expr="//title" position="replace">
            <title t-esc="title or 'Australian Diversity Care'"/>
        </xpath>
    </template>

    <!-- Client summary at the top of My account for participants and representatives. -->
    <template id="portal_my_home_care_summary" inherit_id="portal.portal_my_home" priority="50">
        <xpath expr="//div[hasclass('o_portal_docs')]" position="before">
            <t t-if="care_home" t-call="binaryaid_care.client_home_summary"/>
        </xpath>
    </template>

    <!-- Support request pages share the branded portal header and footer. -->
    <template id="client_layout" name="ADC client portal page">
        <t t-call="web.frontend_layout">
            <t t-set="title">Support requests · ADC</t>
            <t t-set="is_portal" t-value="True"/>
            <div class="adc_wrap adc_main">
                <t t-out="0"/>
            </div>
        </t>
    </template>

    <template id="client_status">
        <span t-att-class="'adc_pill adc_tone_' + tones.get(record.state, 'muted')"><span class="adc_dot"/><t t-esc="state_labels.get(record.state)"/></span>
    </template>

    <template id="client_request_row">
        <a t-attf-href="/my/support-requests/#{record.id}" class="adc_row">
            <span class="adc_date_tile">
                <small t-esc="record.preferred_date_from.strftime('%b')"/>
                <strong t-esc="record.preferred_date_from.day"/>
            </span>
            <span class="adc_row_body">
                <strong t-esc="record.support_needs.splitlines()[0][:80] if record.support_needs else record.name"/>
                <span class="adc_muted"><t t-esc="record.sudo().client_id.name"/> · <t t-esc="record.name"/>
                    <t t-if="record.preferred_start_time or record.preferred_end_time"> · <t t-esc="'%02d:%02d' % (int(record.preferred_start_time), round(record.preferred_start_time % 1 * 60))"/>–<t t-esc="'%02d:%02d' % (int(record.preferred_end_time), round(record.preferred_end_time % 1 * 60))"/></t></span>
            </span>
            <t t-call="binaryaid_care.client_status"/>
            <i class="fa fa-angle-right adc_chevron" aria-hidden="true"/>
        </a>
    </template>

    <template id="client_visit_row">
        <div class="adc_row is_static">
            <span class="adc_date_tile is_green"><small t-esc="visit['month']"/><strong t-esc="visit['day']"/></span>
            <span class="adc_row_body">
                <strong><t t-esc="visit['weekday']"/> · <t t-esc="visit['time']"/></strong>
                <span class="adc_muted"><t t-esc="visit['client']"/><t t-if="visit['place']"> · <t t-esc="visit['place']"/></t></span>
            </span>
            <span class="adc_pill adc_tone_green"><span class="adc_dot"/>Confirmed</span>
        </div>
    </template>

    <!-- ============================================================ client summary on /my -->
    <template id="client_home_summary" name="ADC client summary">
        <t t-set="h" t-value="care_home"/>
        <div class="adc_summary">
            <section class="adc_hero">
                <div>
                    <span class="adc_eyebrow">Welcome back</span>
                    <h1>Hello, <t t-esc="h['first_name']"/></h1>
                    <p>Request support for <t t-esc="', '.join(h['clients'].mapped('name'))"/> and follow every request in one place.</p>
                </div>
                <a href="/my/support-requests/new" class="adc_btn adc_btn_light adc_btn_lg"><i class="fa fa-plus" aria-hidden="true"/> Request support</a>
            </section>
            <section class="adc_stats">
                <a href="/my/support-requests?status=open" class="adc_stat adc_tone_amber"><span class="adc_stat_icon"><i class="fa fa-hourglass-half" aria-hidden="true"/></span><span><strong t-esc="h['stats']['open']"/><small>Open requests</small></span></a>
                <a href="/my/support-requests?status=scheduled" class="adc_stat adc_tone_green"><span class="adc_stat_icon"><i class="fa fa-check-circle" aria-hidden="true"/></span><span><strong t-esc="h['stats']['scheduled']"/><small>Scheduled</small></span></a>
                <a href="#adc_visits" class="adc_stat adc_tone_blue"><span class="adc_stat_icon"><i class="fa fa-calendar" aria-hidden="true"/></span><span><strong t-esc="h['stats']['visits']"/><small>Upcoming visits</small></span></a>
            </section>
            <div class="adc_grid">
                <section class="adc_card" id="adc_visits">
                    <div class="adc_card_head"><h2>Upcoming visits</h2></div>
                    <div t-if="not h['visits']" class="adc_empty"><i class="fa fa-calendar-o" aria-hidden="true"/><p>No visits are booked yet. Confirmed support appears here.</p></div>
                    <t t-foreach="h['visits']" t-as="visit"><t t-call="binaryaid_care.client_visit_row"/></t>
                </section>
                <section class="adc_card">
                    <div class="adc_card_head"><h2>Recent requests</h2><a href="/my/support-requests" class="adc_link">View all <i class="fa fa-arrow-right" aria-hidden="true"/></a></div>
                    <div t-if="not h['requests']" class="adc_empty"><i class="fa fa-inbox" aria-hidden="true"/><p>You have not requested support yet.</p>
                        <a href="/my/support-requests/new" class="adc_btn adc_btn_primary">Request support</a></div>
                    <t t-set="tones" t-value="h['tones']"/><t t-set="state_labels" t-value="h['state_labels']"/>
                    <t t-foreach="h['requests']" t-as="record"><t t-call="binaryaid_care.client_request_row"/></t>
                </section>
            </div>
            <h2 class="adc_section_title">Your account</h2>
        </div>
    </template>

    <!-- ============================================================ list -->
    <template id="client_requests" name="ADC client requests">
        <t t-call="binaryaid_care.client_layout">
            <div class="adc_page_head">
                <div><h1>My requests</h1><p class="adc_muted">Every request you have made and where it is up to.</p></div>
                <a t-if="care_clients" href="/my/support-requests/new" class="adc_btn adc_btn_primary"><i class="fa fa-plus" aria-hidden="true"/> New request</a>
            </div>
            <div class="adc_chips">
                <a t-foreach="filters" t-as="f" t-attf-href="/my/support-requests?status=#{f[0]}" t-att-class="'adc_chip' + (' is_active' if status == f[0] else '')" t-esc="f[1]"/>
            </div>
            <section class="adc_card">
                <div t-if="not care_requests" class="adc_empty"><i class="fa fa-inbox" aria-hidden="true"/><p>No requests here yet.</p></div>
                <t t-foreach="care_requests" t-as="record"><t t-call="binaryaid_care.client_request_row"/></t>
            </section>
        </t>
    </template>

    <!-- ============================================================ detail -->
    <template id="client_request" name="ADC client request">
        <t t-call="binaryaid_care.client_layout">
            <t t-set="record" t-value="care_request"/>
            <a href="/my/support-requests" class="adc_back"><i class="fa fa-arrow-left" aria-hidden="true"/> My requests</a>
            <div t-if="created" class="adc_alert adc_tone_green"><i class="fa fa-check-circle" aria-hidden="true"/> Thank you. Your request was submitted for review. We will let you know when it changes.</div>
            <section class="adc_card adc_detail">
                <div class="adc_detail_head">
                    <div><span class="adc_eyebrow" t-esc="record.name"/><h1 t-esc="record.support_needs.splitlines()[0][:90] if record.support_needs else record.name"/>
                        <span class="adc_muted">For <t t-esc="client_name"/> · Submitted <t t-esc="record.create_date.strftime('%d %b %Y')"/></span></div>
                    <t t-call="binaryaid_care.client_status"/>
                </div>
                <ol t-if="record.state not in ('declined', 'cancelled')" class="adc_timeline">
                    <li t-foreach="timeline" t-as="step" t-att-class="'is_done' if step_index &lt;= reached else ''">
                        <span class="adc_step_dot"><i t-if="step_index &lt;= reached" class="fa fa-check" aria-hidden="true"/><t t-else="" t-esc="step_index + 1"/></span>
                        <span t-esc="step[1]"/>
                    </li>
                </ol>
                <div t-if="record.state == 'declined'" class="adc_alert adc_tone_red"><i class="fa fa-info-circle" aria-hidden="true"/> ADC could not provide this support. See the response below.</div>
                <div t-if="record.state == 'cancelled'" class="adc_alert adc_tone_muted"><i class="fa fa-ban" aria-hidden="true"/> This request was cancelled.</div>
                <div class="adc_facts">
                    <div><small>Preferred date</small><strong><t t-esc="record.preferred_date_from.strftime('%A %d %B %Y')"/><t t-if="record.preferred_date_to"> – <t t-esc="record.preferred_date_to.strftime('%d %B')"/></t></strong></div>
                    <div><small>Preferred time</small><strong t-if="record.preferred_start_time or record.preferred_end_time"><t t-esc="'%02d:%02d' % (int(record.preferred_start_time), round(record.preferred_start_time % 1 * 60))"/> – <t t-esc="'%02d:%02d' % (int(record.preferred_end_time), round(record.preferred_end_time % 1 * 60))"/></strong><strong t-else="">Any time</strong></div>
                    <div><small>Location</small><strong t-esc="location_name or record.location_note or 'To be confirmed'"/></div>
                </div>
                <h3>Support needed</h3>
                <p class="adc_text" t-esc="record.support_needs"/>
                <t t-if="record.instructions"><h3>Your instructions</h3><p class="adc_text" t-esc="record.instructions"/></t>
                <div t-if="record.review_note" class="adc_response"><h3><i class="fa fa-comment-o" aria-hidden="true"/> Response from ADC</h3><p class="adc_text" t-esc="record.review_note"/></div>
                <t t-if="visits"><h3>Confirmed visits</h3><t t-foreach="visits" t-as="visit"><t t-call="binaryaid_care.client_visit_row"/></t></t>
                <form t-if="record.state in ('submitted', 'in_review')" t-attf-action="/my/support-requests/#{record.id}/cancel" method="post" class="adc_cancel">
                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                    <span class="adc_muted">Changed your mind? You can cancel until ADC approves the request.</span>
                    <button type="submit" class="adc_btn adc_btn_danger_outline">Cancel this request</button>
                </form>
            </section>
        </t>
    </template>

    <!-- ============================================================ new request -->
    <template id="client_request_new" name="ADC new support request">
        <t t-call="binaryaid_care.client_layout">
            <div class="adc_page_head"><div><h1>Request support</h1><p class="adc_muted">Tell us what you need. ADC reviews every request and confirms the visit with you.</p></div></div>
            <div t-if="error" class="adc_alert adc_tone_red"><i class="fa fa-exclamation-circle" aria-hidden="true"/> <t t-esc="error"/></div>
            <div class="adc_form_grid">
                <form action="/my/support-requests/new" method="post" class="adc_card adc_form">
                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                    <fieldset>
                        <legend><span class="adc_step">1</span> Who is the support for?</legend>
                        <div class="adc_choice_grid">
                            <label t-foreach="care_clients" t-as="client" class="adc_choice">
                                <input type="radio" name="client_id" t-att-value="client.id" required="required"
                                       t-att-checked="str(client.id) == post.get('client_id') or (len(care_clients) == 1) or None"/>
                                <span class="adc_choice_box"><span class="adc_person_avatar" t-esc="client.name.replace('[DEMO] ', '')[:1]"/><strong t-esc="client.name"/></span>
                            </label>
                        </div>
                    </fieldset>
                    <fieldset>
                        <legend><span class="adc_step">2</span> What support is needed?</legend>
                        <textarea class="adc_input" name="support_needs" id="support_needs" rows="4" required="required" maxlength="4000"
                                  placeholder="For example: help with shopping and preparing lunch" t-esc="post.get('support_needs', '')"/>
                    </fieldset>
                    <fieldset>
                        <legend><span class="adc_step">3</span> When?</legend>
                        <div class="adc_fields">
                            <label>Preferred date<input type="date" class="adc_input" name="preferred_date_from" id="preferred_date_from" required="required" t-att-min="today" t-att-value="post.get('preferred_date_from')"/></label>
                            <label>Until (optional)<input type="date" class="adc_input" name="preferred_date_to" id="preferred_date_to" t-att-min="today" t-att-value="post.get('preferred_date_to')"/></label>
                            <label>From<input type="time" class="adc_input" name="preferred_start_time" id="preferred_start_time" t-att-value="post.get('preferred_start_time')"/></label>
                            <label>To<input type="time" class="adc_input" name="preferred_end_time" id="preferred_end_time" t-att-value="post.get('preferred_end_time')"/></label>
                        </div>
                    </fieldset>
                    <fieldset>
                        <legend><span class="adc_step">4</span> Where?</legend>
                        <div class="adc_fields">
                            <label>Service location
                                <select class="adc_input" name="location_id" id="location_id">
                                    <option value="">Not sure / somewhere else</option>
                                    <option t-foreach="locations" t-as="loc" t-att-value="loc.id" t-att-selected="str(loc.id) == post.get('location_id') or None"><t t-esc="loc.client_id.name"/> – <t t-esc="loc.name"/></option>
                                </select>
                            </label>
                            <label>Other place or access details<input type="text" class="adc_input" name="location_note" id="location_note" maxlength="255" placeholder="For example: side gate, unit 4" t-att-value="post.get('location_note')"/></label>
                        </div>
                    </fieldset>
                    <fieldset>
                        <legend><span class="adc_step">5</span> Anything else we should know?</legend>
                        <textarea class="adc_input" name="instructions" id="instructions" rows="3" maxlength="4000" placeholder="Preferences, parking, pets, who to call on arrival" t-esc="post.get('instructions', '')"/>
                    </fieldset>
                    <div class="adc_form_actions">
                        <button type="submit" class="adc_btn adc_btn_primary adc_btn_lg"><i class="fa fa-paper-plane" aria-hidden="true"/> Submit request</button>
                        <a href="/my/care" class="adc_btn adc_btn_ghost">Cancel</a>
                    </div>
                </form>
                <aside class="adc_card adc_next">
                    <h2>What happens next</h2>
                    <ol class="adc_next_steps">
                        <li><strong>We review your request</strong><span>Usually within one business day.</span></li>
                        <li><strong>We find a support worker</strong><span>ADC matches a suitable worker.</span></li>
                        <li><strong>You see the confirmed visit</strong><span>The request shows "Scheduled" with the date and time.</span></li>
                    </ol>
                    <p class="adc_muted">For urgent changes please call the ADC office.</p>
                </aside>
            </div>
        </t>
    </template>

</odoo>
