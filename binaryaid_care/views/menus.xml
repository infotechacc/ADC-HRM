<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_shift_coverage_pivot" model="ir.ui.view">
        <field name="name">binaryaid.work.shift.coverage.pivot</field><field name="model">binaryaid.work.shift</field>
        <field name="arch" type="xml">
            <pivot string="Roster coverage" sample="1">
                <field name="start" interval="day" type="col"/><field name="client_id" type="row"/><field name="planned_hours" type="measure"/>
            </pivot>
        </field>
    </record>
    <record id="action_report_coverage" model="ir.actions.act_window">
        <field name="name">Roster Coverage</field><field name="res_model">binaryaid.work.shift</field>
        <field name="view_mode">pivot,list,form</field>
        <field name="domain">[('state', 'in', ['draft', 'published'])]</field>
        <field name="context">{'search_default_start': 1}</field>
        <field name="views" eval="[(ref('view_shift_coverage_pivot'), 'pivot'), (False, 'list'), (False, 'form')]"/>
    </record>
    <record id="action_report_assignments" model="ir.actions.act_window">
        <field name="name">Employee to Client Assignments</field><field name="res_model">binaryaid.work.shift</field>
        <field name="view_mode">list,pivot,form</field>
        <field name="domain">[('client_id', '!=', False), ('state', '!=', 'cancelled')]</field>
        <field name="context">{'search_default_employee': 1, 'search_default_group_client': 1}</field>
    </record>
    <record id="action_report_pending_leave" model="ir.actions.act_window">
        <field name="name">Pending Leave</field><field name="res_model">hr.leave</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state', 'in', ['confirm', 'validate1'])]</field>
    </record>

    <menuitem id="menu_care_root" name="Care Operations" sequence="2" web_icon="hr,static/description/icon.png"
              groups="base.group_user"/>
    <menuitem id="menu_care_clients" name="Clients" parent="menu_care_root" action="action_care_client" sequence="10"
              groups="binaryaid_work_management.group_work_admin,group_care_reviewer"/>
    <menuitem id="menu_care_requests" name="Client Requests" parent="menu_care_root" action="action_client_requests" sequence="20"
              groups="binaryaid_work_management.group_work_admin"/>
    <menuitem id="menu_care_shifts" name="Shifts" parent="menu_care_root" action="binaryaid_work_scheduling.action_work_schedule" sequence="30"
              groups="binaryaid_work_management.group_work_user"/>
    <menuitem id="menu_care_messages" name="Team Messages" parent="menu_care_root" action="action_announcements" sequence="60"
              groups="binaryaid_work_management.group_work_admin"/>
    <menuitem id="menu_care_my_messages" name="My Messages" parent="menu_care_root" action="action_my_announcements" sequence="61"/>
    <menuitem id="menu_care_my_documents" name="My Documents" parent="menu_care_root" action="action_my_documents" sequence="70"/>
    <menuitem id="menu_care_reports" name="Reports" parent="menu_care_root" sequence="80"
              groups="binaryaid_work_management.group_work_admin,hr.group_hr_user,group_care_reviewer"/>
    <menuitem id="menu_report_coverage" name="Roster Coverage" parent="menu_care_reports" action="action_report_coverage" sequence="10" groups="binaryaid_work_management.group_work_admin"/>
    <menuitem id="menu_report_assignments" name="Employee to Client Assignments" parent="menu_care_reports" action="action_report_assignments" sequence="20" groups="binaryaid_work_management.group_work_admin"/>
    <menuitem id="menu_report_documents" name="Document Exceptions" parent="menu_care_reports" action="action_care_documents" sequence="50" groups="binaryaid_work_management.group_work_admin,hr.group_hr_user"/>
    <menuitem id="menu_report_leave" name="Pending Leave" parent="menu_care_reports" action="action_report_pending_leave" sequence="60" groups="hr_holidays.group_hr_holidays_user"/>
    <menuitem id="menu_care_config" name="Configuration" parent="menu_care_root" sequence="100" groups="binaryaid_work_management.group_work_admin"/>
    <menuitem id="menu_care_settings" name="Settings" parent="menu_care_config" action="action_care_settings" sequence="1" groups="base.group_system"/>
    <menuitem id="menu_care_categories" name="Document Categories" parent="menu_care_config" action="action_document_category" sequence="10"/>
</odoo>
