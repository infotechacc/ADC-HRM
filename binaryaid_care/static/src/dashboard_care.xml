<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="binaryaid_care.DashboardMessages" t-inherit="binaryaid_hrms_dashboard.Dashboard" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('ba_worker_panels_slot')]" position="inside">
            <section t-if="d.messages and d.messages.items.length" class="ba_card ba_messages_panel" aria-label="Team messages">
                <div class="ba_card_header">
                    <h2>Team messages<span t-if="d.messages.unread" class="ba_count" t-esc="d.messages.unread"/></h2>
                    <button type="button" class="btn btn-link ms-auto" t-on-click="() => this.openSection('team_messages')">View all</button>
                </div>
                <button t-foreach="d.messages.items" t-as="msg" t-key="msg.id" type="button" t-att-class="'ba_message' + (msg.read ? '' : ' is_unread')"
                        t-on-click="() => this.itemAction({source: 'message', id: msg.id, title: msg.title}, {name: 'open', label: 'Open'})">
                    <span class="ba_message_dot" aria-hidden="true"/>
                    <span class="ba_message_text"><span class="ba_message_title" t-esc="msg.title"/><span class="ba_message_date" t-esc="msg.date"/></span>
                    <span t-if="msg.needs_ack" class="badge text-bg-warning">Acknowledge</span>
                </button>
            </section>
        </xpath>
    </t>
</templates>
